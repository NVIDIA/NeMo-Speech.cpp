+    ggml_tensor * unary = nullptr;  // F32 [top_k, n_rows]
+    for (int64_t r0 = 0; r0 < n_rows; r0 += chunk) {
+        const int64_t nr = std::min(chunk, n_rows - r0);
+        ggml_tensor * hr = ggml_view_2d(ctx0, h, h->ne[0], nr, h->nb[1], r0*h->nb[1]);
+        ggml_tensor * logits = g.build_lora_mm(output, hr, output_s);
+        if (hparams.f_logit_scale != 0.0f) {
