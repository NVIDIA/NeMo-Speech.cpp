+// DFlash2 drafts on the device (batched serving): the target's LM head on the n_draft rows after each block's anchor,
+// top-k candidates, the selector's edge scores and the greedy left-to-right walk, so a step reads back n_draft ids
+// per sequence instead of a lattice row per block position. h: [n_embd, n_draft*n_blocks], block-major.
+static ggml_tensor * build_dflash2_device_walk(llm_graph_context & g, const llama_model & model, ggml_tensor * tokens,
+        ggml_tensor * h, ggml_tensor * output, ggml_tensor * output_s, int64_t n_draft, int64_t n_blocks,
+        int64_t block_stride) {
+    ggml_context * ctx0 = g.ctx0;
+    const auto & hparams = g.hparams;
+    const int64_t top_k  = hparams.dflash_selector_top_k;
+    const int64_t rank   = hparams.dflash_selector_rank;
+    const int64_t n_rows = n_draft*n_blocks;
+    const int64_t n_vocab = output->ne[1];
