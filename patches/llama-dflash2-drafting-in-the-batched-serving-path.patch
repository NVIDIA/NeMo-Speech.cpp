+void llama_context::set_layer_features_device(const int32_t * layers, int32_t n) {
+    cparams.layer_features = nullptr;
+    cparams.layer_features_ids.clear();
+    buf_layer_features.reset();
+    ctx_layer_features.reset();
+    layer_features_backend = nullptr;
+    sched_need_reserve = true;
+    if (!layers || n <= 0) {
+        return;
+    }
+    for (const auto & b : backends) {
+        const auto type = ggml_backend_dev_type(ggml_backend_get_device(b.get()));
+        if (type == GGML_BACKEND_DEVICE_TYPE_GPU || type == GGML_BACKEND_DEVICE_TYPE_IGPU) {
+            layer_features_backend = b.get();
+            break;
+        }
+    }
+    GGML_ASSERT(layer_features_backend && "layer features need a GPU backend");
+    for (int32_t k = 0; k < n; ++k) {
+        GGML_ASSERT(layers[k] >= 0 && (uint32_t) layers[k] <= model.hparams.n_layer());
+    }
+    ctx_layer_features.reset(ggml_init({ggml_tensor_overhead(), nullptr, true}));
+    ggml_tensor * t = ggml_new_tensor_2d(ctx_layer_features.get(), GGML_TYPE_BF16, (int64_t) n*model.hparams.n_embd,
+                                         cparams.n_batch);
+    ggml_set_name(t, "layer_features");
+    buf_layer_features.reset(ggml_backend_alloc_ctx_tensors(ctx_layer_features.get(), layer_features_backend));
+    GGML_ASSERT(buf_layer_features);
+    cparams.layer_features = t;
+    cparams.layer_features_ids.assign(layers, layers + n);
+}
+
+ggml_tensor * llama_context::get_layer_features_device(ggml_backend_t * backend) const {
+    *backend = layer_features_backend;
+    return cparams.layer_features;
+}
+
+void llama_context::record_event(ggml_backend_event_t ev) {
+    for (const auto & b : backends) {
+        const auto type = ggml_backend_dev_type(ggml_backend_get_device(b.get()));
+        if (type == GGML_BACKEND_DEVICE_TYPE_GPU || type == GGML_BACKEND_DEVICE_TYPE_IGPU) {
+            ggml_backend_event_record(ev, b.get());
+            return;
+        }
+    }
+    GGML_ABORT("record_event needs a GPU backend");
+}
+
+const float * llama_context::get_draft_ids(int32_t * n_draft, int32_t * n_blocks) {
+    if (draft_ids_n == 0) {
+        return nullptr;
+    }
+    draft_ids.resize((size_t) draft_ids_n*draft_ids_blocks);
+    ggml_backend_tensor_get_async(draft_ids_backend, draft_ids_tensor, draft_ids.data(), 0, draft_ids.size()*sizeof(float));
+    ggml_backend_synchronize(draft_ids_backend);
+    *n_draft = draft_ids_n;
+    *n_blocks = draft_ids_blocks;
+    return draft_ids.data();
+}
