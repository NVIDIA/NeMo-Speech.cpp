+    // the first draft follows the anchor (the block's first token): one predecessor
+    ggml_tensor * anchor_ids = ggml_cont_1d(ctx0,
+            ggml_view_2d(ctx0, tokens, 1, n_blocks, block_stride*tokens->nb[0], 0), n_blocks);
+    ggml_tensor * first = ggml_reshape_2d(ctx0, score_run(0, 1, anchor_ids), top_k, n_blocks);
+    ggml_tensor * rest = nullptr;
+    if (n_draft > 1) {
+        ggml_tensor * prev_ids = ggml_reshape_1d(ctx0, ggml_cont(ctx0, ggml_view_3d(ctx0, cand_blk, top_k,
+                n_draft - 1, n_blocks, cand_blk->nb[1], cand_blk->nb[2], 0)), top_k*(n_draft - 1)*n_blocks);
+        rest = score_run(1, n_draft - 1, prev_ids);  // [top_k, top_k, n_draft - 1, n_blocks]
+    }
