+// Sparse stream-K over the real work: prefix[i] = number of nbatch_fa batches of the query tiles before tile i (from the
+// index-list counts), prefix[n_tiles] = total. One block.
+__launch_bounds__(1024, 1)
+static __global__ void flash_attn_sparse_work_prefix(
+        const int * __restrict__ counts, int * __restrict__ prefix, const int n_tiles, const int nbatch_fa) {
+    ggml_cuda_pdl_sync();
+    const int lane = threadIdx.x % WARP_SIZE;
+    const int warp = threadIdx.x / WARP_SIZE;
+    __shared__ int s_warp[1024/WARP_SIZE];
+    int carry = 0;
+    for (int i0 = 0; i0 < n_tiles; i0 += blockDim.x) {
+        const int i = i0 + threadIdx.x;
+        const int v = i < n_tiles ? (counts[i] + nbatch_fa - 1)/nbatch_fa : 0;
+        int x = v;
+#pragma unroll
+        for (int o = 1; o < WARP_SIZE; o <<= 1) {
+            const int y = __shfl_up_sync(0xFFFFFFFF, x, o);
+            x += lane >= o ? y : 0;
+        }
+        if (lane == WARP_SIZE - 1) {
+            s_warp[warp] = x;
+        }
+        __syncthreads();
+        if (warp == 0) {
+            int w = lane < int(blockDim.x/WARP_SIZE) ? s_warp[lane] : 0;
+#pragma unroll
+            for (int o = 1; o < WARP_SIZE; o <<= 1) {
+                const int y = __shfl_up_sync(0xFFFFFFFF, w, o);
+                w += lane >= o ? y : 0;
+            }
+            s_warp[lane] = w;
+        }
+        __syncthreads();
+        const int incl = carry + x + (warp > 0 ? s_warp[warp - 1] : 0);
+        if (i < n_tiles) {
+            prefix[i] = incl - v;
+        }
+        carry += s_warp[blockDim.x/WARP_SIZE - 1];
+        __syncthreads();
+    }
+    if (threadIdx.x == 0) {
+        prefix[n_tiles] = carry;
+    }
+    ggml_cuda_pdl_lc();
+}
+
+// Largest jt in [0, n) with prefix[jt] <= r (prefix[0] = 0 <= r < prefix[n]).
+static __device__ __forceinline__ int flash_attn_sparse_work_tile(const int * __restrict__ prefix, const int n, const int r) {
+    int lo = 0, hi = n;
+    while (hi - lo > 1) {
+        const int mid = (lo + hi)/2;
+        if (prefix[mid] <= r) {
+            lo = mid;
+        } else {
+            hi = mid;
+        }
+    }
+    return lo;
+}
+
+// Fixup for the balanced sparse split (single sequence, Q->ne[3] == 1): work item kbc = zz*W_j + prefix[jt] + kb0 with
+// zz = z_KV*iter_z_gqa + zt_gqa; block b owns [b*W/gridDim.x, (b+1)*W/gridDim.x).
+template <int D, int ncols1, int ncols2> // D == head size
+__launch_bounds__(D, 1)
+static __global__ void flash_attn_stream_k_fixup_sparse(
+        float * dst_ptr,
+        const float2 * dst_fixup_ptr,
+        const int * __restrict__ prefix,
+        const int ne01, const int ne02,
+        const int gqa_ratio,
+        const int iter_j,
+        const int iter_z_gqa,
+        const int n_z) {
+    float        * GGML_CUDA_RESTRICT dst       = dst_ptr;
+    const float2 * GGML_CUDA_RESTRICT dst_fixup = dst_fixup_ptr;
+    constexpr int ncols = ncols1*ncols2;
+
+    const int bidx0 = blockIdx.x;
+    const int j     = blockIdx.y;
+    const int c     = blockIdx.z;
+    const int jc    = j*ncols2 + c;
+    const int tid   = threadIdx.x;
+
+    const float * dst_fixup_data = ((const float *) dst_fixup) + gridDim.x*(2*2*ncols);
+
+    ggml_cuda_pdl_sync();
+    const int     Wj = prefix[iter_j];
+    const int64_t W  = int64_t(Wj)*n_z;
+
+    const int64_t kbc0      = int64_t(bidx0 + 0)*W / gridDim.x;
+    const int64_t kbc0_stop = int64_t(bidx0 + 1)*W / gridDim.x;
+    if (kbc0 == kbc0_stop) {
+        return; // no data
+    }
+    const int zz = int(kbc0 / Wj);
+    const int jt = flash_attn_sparse_work_tile(prefix, iter_j, int(kbc0 - int64_t(zz)*Wj));
+    const int64_t tile_start = int64_t(zz)*Wj + prefix[jt];
+    const int64_t tile_end   = int64_t(zz)*Wj + prefix[jt + 1];
+    if (kbc0 == tile_start || kbc0_stop < tile_end) {
+        return; // wrote the beginning of the tile, or a piece that does not reach its end
+    }
+
+    const int z_KV   = zz / iter_z_gqa;
+    const int zt_gqa = zz % iter_z_gqa;
+    const int zt_Q   = z_KV*gqa_ratio + zt_gqa*ncols2; // Global Q head start index.
+
+    if (jt*ncols1 + j >= ne01 || zt_gqa*ncols2 + c >= gqa_ratio) {
+        return;
+    }
+
+    dst += jt*ne02*(ncols1*D) + zt_Q*D + (j*ne02 + c)*D + tid;
+
+    // the partial result of this block (the end of the tile)
+    float dst_val = *dst;
+    float max_val;
+    float rowsum;
+    {
+        const float2 tmp = dst_fixup[bidx0*ncols + jc];
+        max_val = tmp.x;
+        rowsum  = tmp.y;
+    }
+
+    // combine the earlier blocks' partial results of this tile
+    int bidx = bidx0 - 1;
+    int64_t kbc_stop = kbc0;
+    while (true) {
+        const int64_t kbc = int64_t(bidx)*W / gridDim.x;
+        if (kbc == kbc_stop) { // Did not have any data.
+            bidx--;
+            kbc_stop = kbc;
+            continue;
+        }
+
+        const float dst_add = dst_fixup_data[bidx*ncols*D + jc*D + tid];
+
+        const float2 tmp = dst_fixup[(gridDim.x + bidx)*ncols + jc];
+
+        const float max_val_new = fmaxf(max_val, tmp.x);
+
+        const float diff_val = max_val - max_val_new;
+        const float diff_add = tmp.x   - max_val_new;
+
+        const float scale_val = diff_val >= SOFTMAX_FTZ_THRESHOLD ? expf(diff_val) : 0.0f;
+        const float scale_add = diff_add >= SOFTMAX_FTZ_THRESHOLD ? expf(diff_add) : 0.0f;
+
+        dst_val = scale_val*dst_val + scale_add*dst_add;
+        rowsum  = scale_val*rowsum  + scale_add*tmp.y;
+
+        max_val = max_val_new;
+
+        if (kbc <= tile_start) {
+            break; // this block holds the beginning of the tile
+        }
+        bidx--;
+        kbc_stop = kbc;
+    }
+
+    *dst = dst_val / rowsum;
+}
