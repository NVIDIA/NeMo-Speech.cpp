+void llama_context::set_token_mask(const uint8_t * banned, int32_t n_vocab) {
+    token_mask.bias.clear();
+    if (banned) {
+        token_mask.bias.resize(n_vocab);
+        for (int32_t i = 0; i < n_vocab; ++i) {
+            token_mask.bias[i] = banned[i] ? -INFINITY : 0.0f;
+        }
+    }
+    token_mask.seq_armed.assign(cparams.n_seq_max, 0);
+}
+
+void llama_context::set_seq_token_mask(llama_seq_id seq_id, bool armed) {
+    if (seq_id < 0 || (size_t) seq_id >= token_mask.seq_armed.size()) {
+        return;
+    }
+    token_mask.seq_armed[seq_id] = armed ? 1 : 0;
+}
+
+void llama_set_token_mask(llama_context * ctx, const uint8_t * banned, int32_t n_vocab) {
+    ctx->set_token_mask(banned, n_vocab);
+}
+
+void llama_set_seq_token_mask(llama_context * ctx, llama_seq_id seq_id, bool armed) {
+    ctx->set_seq_token_mask(seq_id, armed);
+}
