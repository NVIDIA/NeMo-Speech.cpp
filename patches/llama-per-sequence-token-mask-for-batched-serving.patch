+void llm_graph_input_token_mask::set_input(const llama_ubatch * ubatch) {
+    const int64_t n_vocab = table->ne[0];
+    GGML_ASSERT((int64_t) mask->bias.size() == n_vocab);
+    if (!rows) {  // every row armed: the bias alone, broadcast over the rows
+        ggml_backend_tensor_set(table, mask->bias.data(), 0, ggml_nbytes(table));
+        return;
+    }
+    std::vector<float> host(2*n_vocab, 0.0f);
+    std::copy(mask->bias.begin(), mask->bias.end(), host.begin() + n_vocab);
+    ggml_backend_tensor_set(table, host.data(), 0, ggml_nbytes(table));
+    std::vector<int32_t> sel(rows->ne[0], 0);
+    int64_t r = 0;
+    for (uint32_t i = 0; i < ubatch->n_tokens && r < rows->ne[0]; ++i) {
+        if (!ubatch->output[i]) continue;
+        const llama_seq_id s = ubatch->seq_id[i][0];
+        sel[r++] = s >= 0 && (size_t) s < mask->seq_armed.size() && mask->seq_armed[s] ? 1 : 0;
+    }
+    ggml_backend_tensor_set(rows, sel.data(), 0, ggml_nbytes(rows));
+}
+
+bool llm_graph_input_token_mask::can_reuse(const llm_graph_params & params) {
+    // the table shape follows token_mask_mode, which allow_reuse compares; the row selector has one row per output
+    if (!rows) {
+        return params.token_mask_mode == 2;
+    }
+    int64_t n_out = 0;
+    for (uint32_t i = 0; i < params.ubatch.n_tokens; ++i) {
+        n_out += params.ubatch.output[i] != 0;
+    }
+    return params.token_mask_mode == 1 && rows->ne[0] == n_out;
+}
