+// Banned-token bias of the batched serving path and the sequences it applies to.
+struct llama_token_mask {
+    std::vector<float>   bias;       // n_vocab: 0, or -inf for a banned token; empty = no mask
+    std::vector<uint8_t> seq_armed;  // per sequence id
+
+    // graph topology for a ubatch: 0 = no output row is armed, 1 = some are, 2 = all are
+    int mode(const llama_ubatch & ubatch) const {
+        if (bias.empty() || !ubatch.output) return 0;
+        bool any = false, all = true;
+        for (uint32_t i = 0; i < ubatch.n_tokens; ++i) {
+            if (!ubatch.output[i]) continue;
+            const llama_seq_id s = ubatch.seq_id[i][0];
+            const bool armed = s >= 0 && (size_t) s < seq_armed.size() && seq_armed[s];
+            any |= armed;
+            all &= armed;
+        }
+        return !any ? 0 : all ? 2 : 1;
+    }
+};
+
+// Per output row: which bias row (0 = none, 1 = the mask) its logits get.
+class llm_graph_input_token_mask : public llm_graph_input_i {
+public:
+    explicit llm_graph_input_token_mask(const llama_token_mask * mask) : mask(mask) {}
+    virtual ~llm_graph_input_token_mask() = default;
+
+    void set_input(const llama_ubatch * ubatch) override;
+    bool can_reuse(const llm_graph_params & params) override;
+
+    const llama_token_mask * mask;
+    ggml_tensor * table = nullptr;  // F32 [n_vocab, 1] (all rows armed: the bias) or [n_vocab, 2] (zeros, bias)
+    ggml_tensor * rows  = nullptr;  // I32 [n_rows], the table row of each output row (mixed rows only)
+};
