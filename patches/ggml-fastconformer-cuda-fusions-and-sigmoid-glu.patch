+inline static void ggml_vec_sigmoid_glu_f32(const int n, float * y, const float * x, const float * g) {
+    for (int i = 0; i < n; ++i) {
+        y[i] = g[i] / (1.0f + expf(-x[i]));
+    }
+}
+
+inline static void ggml_vec_sigmoid_glu_f16(const int n, ggml_fp16_t * y, const ggml_fp16_t * x, const ggml_fp16_t * g) {
+    for (int i = 0; i < n; ++i) {
+        const float v = GGML_CPU_FP16_TO_FP32(x[i]);
+        y[i] = GGML_CPU_FP32_TO_FP16(GGML_CPU_FP16_TO_FP32(g[i]) / (1.0f + expf(-v)));
+    }
+}
