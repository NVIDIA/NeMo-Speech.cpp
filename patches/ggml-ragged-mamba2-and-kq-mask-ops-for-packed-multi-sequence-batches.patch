+template <int L>
+static __global__ void __launch_bounds__(128) ssm_replay_f16(
+        half * __restrict__ rows, const int64_t row_stride, const int64_t S,
+        const float * __restrict__ x, const int64_t x_tok, const float * __restrict__ dt, const int64_t dt_tok,
+        const float * __restrict__ A, const int64_t A_h, const float * __restrict__ B, const int64_t B_tok,
+        const float * __restrict__ C, const int64_t C_tok, const int32_t * __restrict__ offsets,
+        float * __restrict__ y, const int H, const int G, const int32_t * __restrict__ wids) {
+    constexpr int P = 64, N = 128;
+    const int seq = blockIdx.x, h = blockIdx.y, g = h / (H / G);
+    const int tid = threadIdx.x, lane = tid % WARP_SIZE, warp = tid / WARP_SIZE;
+    const int64_t t = offsets[seq];
+    half * row = rows + (int64_t) (wids ? wids[seq] : seq) * row_stride;  // pinned cells: the row is the sequence's cell
+    half * h0 = row + (int64_t) h * P * N;
+    half * pos = row + S;
+    float * dtc = (float *) (row + S + H);
+    half * xc = row + S + H + 2 * L * H;
+    half * bc = xc + (int64_t) L * H * P;
+
+    __shared__ float s_C[N], s_Bt[N], s_dt[L], s_cb[L], s_coef[L], s_dd[L], s_y[P], s_total;
+    __shared__ int s_j;
+    const float a = A[h * A_h];
+    if (tid == 0) s_j = (int) __half2float(pos[h]);
+    s_C[tid] = C[t * C_tok + g * N + tid];
+    s_Bt[tid] = B[t * B_tok + g * N + tid];
+    __syncthreads();
+    const int j = s_j;
+    if (tid == 0) {
+        float d = dt[t * dt_tok + h];
+        s_dt[j] = d <= 20.0f ? log1pf(expf(d)) : d;
+    }
+    if (tid < j) s_dt[tid] = dtc[tid * H + h];
+    for (int k = warp; k <= j; k += 4) {
+        float acc = 0.0f;
+        for (int n = lane; n < N; n += WARP_SIZE) {
+            const float bk = k < j ? __half2float(bc[(int64_t) k * G * N + g * N + n]) : s_Bt[n];
+            acc += bk * s_C[n];
+        }
+        acc = warp_reduce_sum(acc);
+        if (lane == 0) s_cb[k] = acc;
+    }
+    __syncthreads();
+    if (tid == 0) {
+        float dec = 1.0f;  // exp(sum_{m=k+1..j} dA_m)
+        for (int k = j; k >= 0; --k) {
+            s_dd[k] = dec * s_dt[k];
+            s_coef[k] = s_dd[k] * s_cb[k];
+            dec *= expf(s_dt[k] * a);
+        }
+        s_total = dec;
+    }
+    __syncthreads();
+    const float xt = tid < P ? x[t * x_tok + h * P + tid] : 0.0f;
+    if (tid < P) {
+        float acc = s_coef[j] * xt;
+        for (int k = 0; k < j; ++k) acc += s_coef[k] * __half2float(xc[(int64_t) k * H * P + h * P + tid]);
+        s_y[tid] = acc;
+        xc[(int64_t) j * H * P + h * P + tid] = __float2half(xt);
+    }
+    bc[(int64_t) j * G * N + g * N + tid] = __float2half(s_Bt[tid]);  // identical values from every head of the group
+    if (tid == 0) dtc[j * H + h] = s_dt[j];
+    __syncthreads();
+    const float total = s_total;
+    // 16-byte loads: half a warp per checkpoint row (N = 128 halves), two rows per warp per iteration
+    const int l16 = lane & 15;
+#pragma unroll
+    for (int it = 0; it < P / 8; ++it) {
+        const int p = warp * (P / 4) + it * 2 + (lane >> 4);
+        float acc = 0.0f;
+        const uint4 v = ((const uint4 *) (h0 + (int64_t) p * N))[l16];
+        const half2 * hv = (const half2 *) &v;
+#pragma unroll
+        for (int q = 0; q < 4; ++q) {
+            const float2 f = __half22float2(hv[q]);
+            const int n = l16 * 8 + q * 2;
+            acc += f.x * s_C[n] + f.y * s_C[n + 1];
+        }
+#pragma unroll
+        for (int off = 8; off > 0; off >>= 1) acc += __shfl_xor_sync(0xffffffff, acc, off);
+        if (l16 == 0) y[t * H * P + h * P + p] = total * acc + s_y[p];
+    }
+    if (j == L - 1) {
+        __shared__ float s_xk[L][P], s_bk[L][N];
+        __syncthreads();
+        for (int i = tid; i < L * P; i += blockDim.x) s_xk[i / P][i % P] = __half2float(xc[(int64_t) (i / P) * H * P + h * P + i % P]);
+        for (int k = 0; k < L; ++k) s_bk[k][tid] = k < j ? __half2float(bc[(int64_t) k * G * N + g * N + tid]) : s_Bt[tid];
+        __syncthreads();
+        for (int e = tid; e < P * N; e += blockDim.x) {
+            const int p = e / N, n = e % N;
+            float v;
+            v = total * __half2float(h0[e]);
+#pragma unroll
+            for (int k = 0; k < L; ++k) v += s_dd[k] * s_xk[k][p] * s_bk[k][n];
+            h0[e] = __float2half(v);
+        }
