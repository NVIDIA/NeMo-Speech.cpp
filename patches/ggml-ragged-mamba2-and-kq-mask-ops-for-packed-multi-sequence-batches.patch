+// Each CTA writes a contiguous stripe of one query's mask. Only compact integer
+// metadata crosses PCIe; the dense FP16/F32 mask stays entirely on the device.
+template<typename T>
+static __global__ void build_kq_mask(const int32_t * pos, const uint32_t * seq,
+        const int32_t * query, T * out, int64_t nk) {
+    const int64_t k = int64_t(blockIdx.x)*blockDim.x + threadIdx.x;
+    const int q = blockIdx.y;
+    if (k >= nk) return;
+    const int qp = query[2*q], qs = query[2*q+1];
+    const bool visible = (seq[int64_t(qs/32)*nk+k] & (uint32_t(1) << (qs%32))) && pos[k] <= qp;
+    out[int64_t(q)*nk+k] = (T)(visible ? 0.0f : -INFINITY);
+}
+
+// Dense mask from the per-sequence cell lists (src[3] offsets, src[4] cells): row q is -inf except the cells of its
+// own sequence at or before its position. Needs no membership words, so the host does not upload them.
+static __global__ void build_kq_mask_lists(const int32_t * pos, const int32_t * query, const int32_t * seq_off,
+        const int32_t * seq_cells, half * out, int64_t nk) {
+    const int q = blockIdx.x;
+    const int qp = query[2*q], qs = query[2*q+1];
+    half * row = out + int64_t(q)*nk;
+    for (int64_t k = threadIdx.x; k < nk; k += blockDim.x) row[k] = half(-INFINITY);
+    __syncthreads();
+    const int b = seq_off[qs], e = seq_off[qs + 1];
+    for (int i = b + threadIdx.x; i < e; i += blockDim.x) {
+        const int c = seq_cells[i];
+        if (pos[c] <= qp) row[c] = half(0.0f);
+    }
+}
+
+void ggml_cuda_build_dense_kq_mask(const ggml_tensor * meta, half * out, cudaStream_t stream) {
+    if (meta->src[3] && meta->src[4]) {
+        build_kq_mask_lists<<<meta->ne[1], 256, 0, stream>>>((const int32_t *) meta->src[0]->data,
+            (const int32_t *) meta->src[2]->data, (const int32_t *) meta->src[3]->data,
+            (const int32_t *) meta->src[4]->data, out, meta->ne[0]);
+        CUDA_CHECK(cudaGetLastError());
+        return;
+    }
+    const dim3 grid((meta->ne[0]+255)/256, meta->ne[1]);
+    build_kq_mask<<<grid, 256, 0, stream>>>((const int32_t *) meta->src[0]->data,
+            (const uint32_t *) meta->src[1]->data, (const int32_t *) meta->src[2]->data, out, meta->ne[0]);
+    CUDA_CHECK(cudaGetLastError());
+}
+
+void ggml_cuda_op_build_kq_mask(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    if (ggml_get_op_params_i32(dst, 1) == 1) {
+        return; // metadata only, flash attention reads the sources
+    }
+    const dim3 grid((dst->ne[0]+255)/256, dst->ne[1]);
+    if (dst->type == GGML_TYPE_F16) {
+        build_kq_mask<<<grid, 256, 0, ctx.stream()>>>((const int32_t *) dst->src[0]->data,
+                (const uint32_t *) dst->src[1]->data, (const int32_t *) dst->src[2]->data,
+                (half *) dst->data, dst->ne[0]);
+    } else {
+        build_kq_mask<<<grid, 256, 0, ctx.stream()>>>((const int32_t *) dst->src[0]->data,
+                (const uint32_t *) dst->src[1]->data, (const int32_t *) dst->src[2]->data,
+                (float *) dst->data, dst->ne[0]);
+    }
+    CUDA_CHECK(cudaGetLastError());
+}
