index 0000000000000000000000000000000000000000..6d23011d0e9a7544441f289fcbf5e535b3738c54
--- /dev/null
+++ b/ggml/src/ggml-cuda/ssm-gate-norm.cu
@@ -0,0 +1,62 @@
+#include "ssm-gate-norm.cuh"
+
+// One block per (group, token): v = (y + x*D[head]) * silu(z); out = v * rsqrt(mean(v^2) + eps) * w.
+// Replaces mul, add, cont(z), swiglu, rms_norm and the weight mul of the unfused Mamba-2 output path.
+template <int NPT>
+static __global__ void ssm_gate_norm_f32(const float * __restrict__ y, const float * __restrict__ x,
+        const float * __restrict__ D, const float * __restrict__ z, const float * __restrict__ w,
+        float * __restrict__ out, const int head_dim, const int gs, const int64_t y_h, const int64_t y_t,
+        const int64_t x_h, const int64_t x_t, const int64_t z_h, const int64_t z_t, const int64_t o_t, const float eps) {
+    const int g = blockIdx.x;
+    const int64_t t = blockIdx.y;
+    float v[NPT];
+    float ss = 0.0f;
+#pragma unroll
+    for (int k = 0; k < NPT; ++k) {
+        const int c = g*gs + threadIdx.x + k*blockDim.x;
+        v[k] = 0.0f;
+        if (threadIdx.x + k*blockDim.x < gs) {
+            const int h = c / head_dim, p = c % head_dim;
+            const float zz = z[t*z_t + h*z_h + p];
+            const float val = (y[t*y_t + h*y_h + p] + x[t*x_t + h*x_h + p]*D[h]) * (zz / (1.0f + expf(-zz)));
+            v[k] = val;
+            ss += val*val;
+        }
+    }
+    ss = warp_reduce_sum(ss);
+    __shared__ float s_part[32];
+    const int lane = threadIdx.x % WARP_SIZE, warp = threadIdx.x / WARP_SIZE;
+    if (lane == 0) s_part[warp] = ss;
+    __syncthreads();
+    if (warp == 0) {
+        ss = lane < (int) (blockDim.x / WARP_SIZE) ? s_part[lane] : 0.0f;
+        ss = warp_reduce_sum(ss);
+        if (lane == 0) s_part[0] = ss;
+    }
+    __syncthreads();
+    const float scale = rsqrtf(s_part[0] / gs + eps);
+#pragma unroll
+    for (int k = 0; k < NPT; ++k) {
+        const int c = g*gs + threadIdx.x + k*blockDim.x;
+        if (threadIdx.x + k*blockDim.x < gs) out[t*o_t + c] = v[k] * scale * w[c];
+    }
+}
+
+void ggml_cuda_op_ssm_gate_norm(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * y = dst->src[0], * x = dst->src[1], * D = dst->src[2], * z = dst->src[3], * w = dst->src[4];
+    const int n_group = ggml_get_op_params_i32(dst, 0);
+    const float eps = ggml_get_op_params_f32(dst, 1);
+    const int head_dim = (int) y->ne[0], n_head = (int) y->ne[1];
+    const int64_t T = y->ne[2];
+    const int gs = head_dim*n_head / n_group;
+    const int threads = 256;
+    GGML_ASSERT(gs <= threads*4);
+    const dim3 grid(n_group, (unsigned) T);
+    const auto e = [](const ggml_tensor * t, int i) { return (int64_t) (t->nb[i] / sizeof(float)); };
+#define LAUNCH(NPT) ssm_gate_norm_f32<NPT><<<grid, threads, 0, ctx.stream()>>>((const float *) y->data, \
+        (const float *) x->data, (const float *) D->data, (const float *) z->data, (const float *) w->data, \
+        (float *) dst->data, head_dim, gs, e(y,1), e(y,2), e(x,1), e(x,2), e(z,1), e(z,2), e(dst,1), eps)
+    if (gs <= threads) { LAUNCH(1); } else if (gs <= 2*threads) { LAUNCH(2); } else { LAUNCH(4); }
+#undef LAUNCH
+    CUDA_CHECK(cudaGetLastError());
+}
