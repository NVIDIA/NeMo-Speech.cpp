diff --git a/ggml/src/ggml-cuda/ssm-conv.cu b/ggml/src/ggml-cuda/ssm-conv.cu
index 1463169cf78bf875a8b3da98ae1c5798d77ab9ae..93f3a7f802237445c977375e40cb314914872590 100644
--- a/ggml/src/ggml-cuda/ssm-conv.cu
+++ b/ggml/src/ggml-cuda/ssm-conv.cu
@@ -2,6 +2,158 @@
 #include "ssm-conv.cuh"
 #include "unary.cuh"
 
+// Packed convolution: sequence boundaries are runtime data, not graph shapes.
+template <bool bias_silu>
+static __global__ void ssm_conv_ragged_f32(const float * x, const float * w, const float * states,
+        const int * offsets, float * y, int channels, int tokens, int sequences, int width, int stride,
+        const float * bias) {
+    const int ch = blockIdx.x*blockDim.x + threadIdx.x;
+    if (ch >= channels) return;
+    const int first = blockIdx.y*32;
+    int lo = 0, hi = sequences;
+    while (lo+1 < hi) { const int mid = (lo+hi)/2; if (offsets[mid] <= first) lo=mid; else hi=mid; }
+    int seq = lo;
+    for (int t = first; t < min(tokens, first+32); ++t) {
+        while (seq+1 < sequences && t >= offsets[seq+1]) ++seq;
+        const int local = t-offsets[seq];
+        float sum = 0;
+        for (int j = 0; j < width; ++j) {
+            const int pos = local+j-(width-1);
+            const float v = pos >= 0 ? x[(int64_t)(offsets[seq]+pos)*stride+ch]
+                : states[(seq*channels+ch)*(width-1)+pos+width-1];
+            sum += v*w[ch*width+j];
+        }
+        if constexpr (bias_silu) {
+            sum += bias[ch];
+            sum = sum / (1.0f + expf(-sum));
+        }
+        y[(int64_t)t*channels+ch] = sum;
+    }
+}
+
+// Final conv states (the last width-1 inputs of each sequence) into out[slot][seq] rows.
+static __global__ void ssm_conv_ragged_states(const float * x, const float * states, const int * offsets,
+        float * out, int channels, int sequences, int width, int stride, int K) {
+    const int i = blockIdx.x*blockDim.x + threadIdx.x;
+    const int D = channels*(width-1);
+    if (i >= K*sequences*D) return;
+    const int j = i % (width-1), ch = (i/(width-1)) % channels;
+    const int seq = (i/D) % sequences, slot = i/(D*sequences);
+    const int end = max(0, offsets[seq+1]-offsets[seq]-slot);
+    const int pos = end-(width-1)+j;
+    const float v = pos >= 0 ? x[(int64_t)(offsets[seq]+pos)*stride+ch]
+        : states[(seq*channels+ch)*(width-1)+pos+width-1];
+    out[i] = v;
+}
+
+// One token per sequence (decode): y and the shifted state window in one pass, state rows addressed by cell id
+// (read row ids[s], write row ids[n_seq + s]; pinned recurrent cells).
+template <bool bias_silu>
+static __global__ void ssm_conv_decode_inplace_f32(const float * __restrict__ x, int stride, const float * __restrict__ w,
+        float * rows, int64_t row_stride, const int * __restrict__ ids, const int * __restrict__ offsets, int n_seq,
+        int channels, float * __restrict__ y, const float * __restrict__ bias) {
+    constexpr int W = 4;
+    const int ch = blockIdx.x*blockDim.x + threadIdx.x, seq = blockIdx.y;
+    if (ch >= channels) return;
+    const int t = offsets[seq];
+    const float * src = rows + (int64_t) ids[seq]*row_stride + (int64_t) ch*(W-1);
+    float * dst = rows + (int64_t) ids[n_seq + seq]*row_stride + (int64_t) ch*(W-1);
+    const float s0 = src[0], s1 = src[1], s2 = src[2];
+    const float xt = x[(int64_t) t*stride + ch];
+    const float4 wv = *(const float4 *) (w + (int64_t) ch*W);
+    float sum = s0*wv.x + s1*wv.y + s2*wv.z + xt*wv.w;
+    if constexpr (bias_silu) {
+        sum += bias[ch];
+        sum = sum / (1.0f + expf(-sum));
+    }
+    y[(int64_t) t*channels + ch] = sum;
+    dst[0] = s1; dst[1] = s2; dst[2] = xt;
+}
+
+// MTP verify (serving mtp_replay): each sequence brings seg tokens. First commit the previous call's accepted inputs:
+// the window advances by adv = ids[2n + s] rows of the input history (hist row of the write cell, [MAXT][channels]).
+// Then y for the seg new tokens; their inputs replace the history and the stored window stays at the committed point.
+template <bool bias_silu>
+static __global__ void ssm_conv_verify_f32(const float * __restrict__ x, int stride, const float * __restrict__ w,
+        float * rows, int64_t row_stride, float * hist, int64_t hist_stride, int maxt, const int * __restrict__ ids,
+        const int * __restrict__ offsets, int n_seq, int channels, float * __restrict__ y, const float * __restrict__ bias) {
+    constexpr int W = 4;
+    const int ch = blockIdx.x*blockDim.x + threadIdx.x, seq = blockIdx.y;
+    if (ch >= channels) return;
+    const int rid = ids[seq], wid = ids[n_seq + seq], adv = rid == wid ? ids[2*n_seq + seq] : 0;
+    const float * src = rows + (int64_t) rid*row_stride + (int64_t) ch*(W-1);
+    float * dst = rows + (int64_t) wid*row_stride + (int64_t) ch*(W-1);
+    float * hrow = hist + (int64_t) wid*hist_stride + ch;
+    float s0 = src[0], s1 = src[1], s2 = src[2];
+    for (int k = 0; k < adv && k < maxt; ++k) { s0 = s1; s1 = s2; s2 = hrow[(int64_t) k*channels]; }
+    dst[0] = s0; dst[1] = s1; dst[2] = s2;
+    const float4 wv = *(const float4 *) (w + (int64_t) ch*W);
+    const int t0 = offsets[seq], seg = min(offsets[seq+1] - t0, maxt);
+    for (int i = 0; i < seg; ++i) {
+        const float xt = x[(int64_t) (t0 + i)*stride + ch];
+        float sum = s0*wv.x + s1*wv.y + s2*wv.z + xt*wv.w;
+        if constexpr (bias_silu) {
+            sum += bias[ch];
+            sum = sum / (1.0f + expf(-sum));
+        }
+        y[(int64_t) (t0 + i)*channels + ch] = sum;
+        hrow[(int64_t) i*channels] = xt;
+        s0 = s1; s1 = s2; s2 = xt;
+    }
+}
+
+static void ssm_conv_ragged_cuda(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const auto * x = dst->src[0], * w = dst->src[1], * state = dst->src[2], * offsets = dst->src[3];
+    if (ggml_get_op_params_i32(dst, 2) == 3) {  // MTP verify (ggml_ssm_conv_ragged_verify)
+        const int channels = x->ne[0], n_seq = offsets->ne[0]-1, width = w->ne[0], stride = x->nb[1]/sizeof(float);
+        const ggml_tensor * hist = dst->src[6], * ids = dst->src[5];
+        GGML_ASSERT(width == 4 && x->nb[0] == sizeof(float) && ids && ids->ne[0] == 3*n_seq && hist && hist->type == GGML_TYPE_F32);
+        const int maxt = (int) (hist->ne[0] / channels);
+        const dim3 grid((channels+127)/128, n_seq);
