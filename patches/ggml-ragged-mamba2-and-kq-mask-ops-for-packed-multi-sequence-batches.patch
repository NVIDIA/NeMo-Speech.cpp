+struct ggml_tensor * ggml_build_kq_mask(
+        struct ggml_context * ctx, struct ggml_tensor * key_pos,
+        struct ggml_tensor * key_seq, struct ggml_tensor * query, enum ggml_type type) {
+    GGML_ASSERT(key_pos->type == GGML_TYPE_I32 && key_seq->type == GGML_TYPE_I32 && query->type == GGML_TYPE_I32);
+    // key_seq->ne[0] == 1: no membership words (per-sequence cell lists, ggml_build_kq_mask_meta)
+    GGML_ASSERT((key_pos->ne[0] == key_seq->ne[0] || key_seq->ne[0] == 1) && query->ne[0] == 2);
+    GGML_ASSERT(type == GGML_TYPE_F16 || type == GGML_TYPE_F32);
+    struct ggml_tensor * r = ggml_new_tensor_2d(ctx, type, key_pos->ne[0], query->ne[1]);
+    r->op = GGML_OP_BUILD_KQ_MASK;
+    r->src[0] = key_pos;
+    r->src[1] = key_seq;
+    r->src[2] = query;
+    return r;
+}
+
+struct ggml_tensor * ggml_build_kq_mask_meta(
+        struct ggml_context * ctx, struct ggml_tensor * key_pos, struct ggml_tensor * key_seq,
+        struct ggml_tensor * query, struct ggml_tensor * seq_off, struct ggml_tensor * seq_cells, enum ggml_type type) {
+    GGML_ASSERT(seq_off->type == GGML_TYPE_I32 && seq_cells->type == GGML_TYPE_I32 && seq_cells->ne[0] >= key_pos->ne[0]);
+    struct ggml_tensor * r = ggml_build_kq_mask(ctx, key_pos, key_seq, query, type);
+    r->src[3] = seq_off;
+    r->src[4] = seq_cells;
+    ggml_set_op_params_i32(r, 1, 1);
+    r->nb[1] = r->nb[2] = r->nb[3] = 0;
+    return r;
+}
+
+struct ggml_tensor * ggml_ssm_conv_ragged(
+        struct ggml_context * ctx, struct ggml_tensor * x, struct ggml_tensor * c,
+        struct ggml_tensor * states, struct ggml_tensor * offsets, int64_t K) {
+    GGML_ASSERT(x->type == GGML_TYPE_F32 && c->type == GGML_TYPE_F32 && states->type == GGML_TYPE_F32);
+    GGML_ASSERT(ggml_is_matrix(x) && ggml_is_matrix(c));
+    GGML_ASSERT(x->ne[0] == c->ne[1]);
+    GGML_ASSERT(states->ne[0] == (c->ne[0]-1)*c->ne[1]);
+    GGML_ASSERT(states->ne[1] == offsets->ne[0]-1);
+    GGML_ASSERT(offsets->type == GGML_TYPE_I32 && ggml_is_vector(offsets));
+    GGML_ASSERT(K >= 1 && K <= INT32_MAX);
+    struct ggml_tensor * r = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, ggml_nelements(x) + K*ggml_nelements(states));
+    r->op = GGML_OP_SSM_CONV;
+    r->src[0] = x; r->src[1] = c; r->src[2] = states; r->src[3] = offsets;
+    ggml_set_op_params_i32(r, 0, (int32_t) K);
+    return r;
+}
+
+struct ggml_tensor * ggml_ssm_gate_norm(struct ggml_context * ctx, struct ggml_tensor * y,
+        struct ggml_tensor * x, struct ggml_tensor * D, struct ggml_tensor * z, struct ggml_tensor * w,
+        int n_group, float eps) {
+    GGML_ASSERT(y->type == GGML_TYPE_F32 && x->type == GGML_TYPE_F32 && z->type == GGML_TYPE_F32);
+    GGML_ASSERT(D->type == GGML_TYPE_F32 && w->type == GGML_TYPE_F32 && ggml_is_contiguous(D) && ggml_is_contiguous(w));
+    GGML_ASSERT(ggml_are_same_shape(y, x) && ggml_are_same_shape(y, z) && y->ne[3] == 1);
+    GGML_ASSERT(y->nb[0] == sizeof(float) && x->nb[0] == sizeof(float) && z->nb[0] == sizeof(float));
+    GGML_ASSERT(ggml_nelements(D) == y->ne[1] && ggml_nelements(w) == y->ne[0]*y->ne[1]);
+    GGML_ASSERT(n_group > 0 && (y->ne[0]*y->ne[1]) % n_group == 0);
+    struct ggml_tensor * r = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, y->ne[0]*y->ne[1], y->ne[2]);
+    r->op = GGML_OP_SSM_GATE_NORM;
+    r->src[0] = y; r->src[1] = x; r->src[2] = D; r->src[3] = z; r->src[4] = w;
+    ggml_set_op_params_i32(r, 0, n_group);
+    ggml_set_op_params_f32(r, 1, eps);
+    return r;
+}
+
+struct ggml_tensor * ggml_ssm_conv_ragged_inplace(
+        struct ggml_context * ctx, struct ggml_tensor * x, struct ggml_tensor * c,
+        struct ggml_tensor * rows, struct ggml_tensor * offsets, struct ggml_tensor * ids) {
+    GGML_ASSERT(x->type == GGML_TYPE_F32 && c->type == GGML_TYPE_F32 && rows->type == GGML_TYPE_F32);
+    GGML_ASSERT(ggml_is_matrix(x) && ggml_is_matrix(c) && ggml_is_contiguous(c) && x->ne[0] == c->ne[1]);
+    GGML_ASSERT(rows->ne[0] == (c->ne[0]-1)*c->ne[1] && rows->nb[0] == sizeof(float));
+    GGML_ASSERT(offsets->type == GGML_TYPE_I32 && ggml_is_vector(offsets) && x->ne[1] == offsets->ne[0]-1);
+    GGML_ASSERT(ids->type == GGML_TYPE_I32 && ids->ne[0] == 2*(offsets->ne[0]-1));
+    struct ggml_tensor * r = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, ggml_nelements(x));
+    r->op = GGML_OP_SSM_CONV;
+    r->src[0] = x; r->src[1] = c; r->src[2] = rows; r->src[3] = offsets; r->src[5] = ids;
+    ggml_set_op_params_i32(r, 0, 1);
+    ggml_set_op_params_i32(r, 2, 2);  // in place
+    return r;
+}
+
+// MTP verify conv (serving mtp_replay): rows = conv cache [(d_conv-1)*channels, cells], hist = [MAXT*channels, cells]
+// raw inputs of the last verify call, ids = [read | write | accepted rows] (3 * n_seq).
+struct ggml_tensor * ggml_ssm_conv_ragged_verify(
+        struct ggml_context * ctx, struct ggml_tensor * x, struct ggml_tensor * c,
+        struct ggml_tensor * rows, struct ggml_tensor * hist, struct ggml_tensor * offsets, struct ggml_tensor * ids) {
+    GGML_ASSERT(x->type == GGML_TYPE_F32 && c->type == GGML_TYPE_F32 && rows->type == GGML_TYPE_F32 && hist->type == GGML_TYPE_F32);
+    GGML_ASSERT(ggml_is_matrix(x) && ggml_is_matrix(c) && ggml_is_contiguous(c) && x->ne[0] == c->ne[1]);
+    GGML_ASSERT(rows->ne[0] == (c->ne[0]-1)*c->ne[1] && rows->nb[0] == sizeof(float) && hist->ne[0] % c->ne[1] == 0);
+    GGML_ASSERT(offsets->type == GGML_TYPE_I32 && ggml_is_vector(offsets));
+    GGML_ASSERT(ids->type == GGML_TYPE_I32 && ids->ne[0] == 3*(offsets->ne[0]-1));
+    struct ggml_tensor * r = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, ggml_nelements(x));
+    r->op = GGML_OP_SSM_CONV;
+    r->src[0] = x; r->src[1] = c; r->src[2] = rows; r->src[3] = offsets; r->src[5] = ids; r->src[6] = hist;
+    ggml_set_op_params_i32(r, 0, 1);
+    ggml_set_op_params_i32(r, 2, 3);  // MTP verify
+    return r;
+}
+
+void ggml_ssm_conv_ragged_set_bias_silu(struct ggml_tensor * conv, struct ggml_tensor * bias) {
+    GGML_ASSERT(conv->op == GGML_OP_SSM_CONV && conv->src[3] != NULL);
+    GGML_ASSERT(bias->type == GGML_TYPE_F32 && ggml_nelements(bias) == conv->src[0]->ne[0] && ggml_is_contiguous(bias));
+    conv->src[4] = bias;
+    ggml_set_op_params_i32(conv, 1, 1);
+}
+
+struct ggml_tensor * ggml_ssm_scan_ragged(
+        struct ggml_context * ctx, struct ggml_tensor * s, struct ggml_tensor * x,
+        struct ggml_tensor * dt, struct ggml_tensor * A, struct ggml_tensor * B,
+        struct ggml_tensor * C, struct ggml_tensor * ids, struct ggml_tensor * offsets, int64_t K) {
+    GGML_ASSERT((s->type == GGML_TYPE_F32 || s->type == GGML_TYPE_F16) && x->type == GGML_TYPE_F32);
+    GGML_ASSERT(B->type == GGML_TYPE_F32 && C->type == GGML_TYPE_F32 && dt->type == GGML_TYPE_F32);
+    GGML_ASSERT(s->nb[0] == ggml_type_size(s->type) && s->nb[1] == s->ne[0]*s->nb[0] && s->nb[2] == s->ne[1]*s->nb[1]);
+    GGML_ASSERT(ggml_is_contiguous(dt) && ggml_is_contiguous(A));
+    GGML_ASSERT(x->ne[3] == 1 && B->ne[3] == 1 && C->ne[3] == 1 && dt->ne[2] == 1);
+    GGML_ASSERT(s->ne[1] == x->ne[0] && s->ne[2] == x->ne[1]);
+    GGML_ASSERT(dt->ne[0] == x->ne[1] && dt->ne[1] == x->ne[2]);
+    GGML_ASSERT(A->ne[0] == 1 && A->ne[1] == x->ne[1]);
+    GGML_ASSERT(B->ne[0] == s->ne[0] && B->ne[2] == x->ne[2] && ggml_are_same_shape(B,C));
+    GGML_ASSERT(ids->type == GGML_TYPE_I32 && offsets->type == GGML_TYPE_I32);
+    // ids: [n_seq] read rows, or [2*n_seq] read rows then write rows (pinned recurrent cells)
+    GGML_ASSERT(offsets->ne[0] == ids->ne[0]+1 || ids->ne[0] == 2*(offsets->ne[0]-1) || ids->ne[0] == 3*(offsets->ne[0]-1));
+    GGML_ASSERT(K >= 1 && K <= INT32_MAX);
+    struct ggml_tensor * r = ggml_new_tensor_1d(ctx, GGML_TYPE_F32,
+        ggml_nelements(x) + K*s->ne[0]*s->ne[1]*s->ne[2]*ids->ne[0]);
+    r->op = GGML_OP_SSM_SCAN;
+    r->src[0]=s; r->src[1]=x; r->src[2]=dt; r->src[3]=A;
+    r->src[4]=B; r->src[5]=C; r->src[6]=ids; r->src[7]=offsets;
+    ggml_set_op_params_i32(r, 0, (int32_t) K);
+    return r;
+}
+
+struct ggml_tensor * ggml_ssm_scan_to(struct ggml_context * ctx, struct ggml_tensor * scan, struct ggml_tensor * dst) {
+    GGML_ASSERT(scan->op == GGML_OP_SSM_SCAN && scan->src[3]->ne[0] == 1);
+    GGML_ASSERT((dst->type == GGML_TYPE_F32 || dst->type == GGML_TYPE_F16) && dst->nb[0] == ggml_type_size(dst->type));
+    const int64_t n_seq = scan->src[7] ? scan->src[7]->ne[0]-1 : scan->src[1]->ne[3];
+    const int64_t ds = scan->src[0]->ne[0]*scan->src[0]->ne[1]*scan->src[0]->ne[2];
+    GGML_ASSERT(scan->src[0]->ne[3] == n_seq && dst->ne[0] == ds && dst->ne[1] == n_seq);
+    GGML_ASSERT(dst->nb[1] >= ds*ggml_type_size(dst->type) && dst->ne[2] == ggml_get_op_params_i32(scan, 0));
+    struct ggml_tensor * result = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, ggml_nelements(scan->src[1]));
+    result->op = GGML_OP_SSM_SCAN;
+    memcpy(result->src, scan->src, sizeof(result->src));
+    memcpy(result->op_params, scan->op_params, sizeof(result->op_params));
+    result->src[6] = NULL;
+    result->src[8] = dst;
+    return result;
+}
+
+void ggml_ssm_scan_set_chunks(struct ggml_tensor * scan, struct ggml_tensor * chunks) {
+    GGML_ASSERT(scan->op == GGML_OP_SSM_SCAN && scan->src[7]);
+    GGML_ASSERT(chunks->type == GGML_TYPE_I32 && chunks->ne[0] == 4);
+    scan->src[9] = chunks;
+}
+
+struct ggml_tensor * ggml_ssm_scan_to_indexed(struct ggml_context * ctx, struct ggml_tensor * scan, struct ggml_tensor * dst) {
+    GGML_ASSERT(scan->op == GGML_OP_SSM_SCAN && scan->src[3]->ne[0] == 1 && scan->src[6] && scan->src[7]);
+    GGML_ASSERT((dst->type == GGML_TYPE_F32 || dst->type == GGML_TYPE_F16) && dst->nb[0] == ggml_type_size(dst->type));
+    const int64_t n_seq = scan->src[7]->ne[0]-1;
+    const int64_t ds = scan->src[0]->ne[0]*scan->src[0]->ne[1]*scan->src[0]->ne[2];
+    GGML_ASSERT((scan->src[6]->ne[0] == n_seq || scan->src[6]->ne[0] == 2*n_seq || scan->src[6]->ne[0] == 3*n_seq) &&
+                dst->ne[0] == ds && dst->ne[1] == n_seq);
+    GGML_ASSERT(dst->nb[1] >= ds*ggml_type_size(dst->type) && dst->ne[2] == ggml_get_op_params_i32(scan, 0));
+    struct ggml_tensor * result = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, ggml_nelements(scan->src[1]));
+    result->op = GGML_OP_SSM_SCAN;
+    memcpy(result->src, scan->src, sizeof(result->src));
+    memcpy(result->op_params, scan->op_params, sizeof(result->op_params));
+    result->src[8] = dst;
+    return result;
+}
