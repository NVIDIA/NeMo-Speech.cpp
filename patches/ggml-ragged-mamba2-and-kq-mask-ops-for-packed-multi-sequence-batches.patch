+
+// ---- ReplaySSM verify (serving mtp_replay: speculative decoding with native rollback) ------------------------------
+// Each sequence brings seg <= MAXT tokens (last accepted token + drafts). Committed cache entries: j = pos[h] + adv[s]
+// (adv = rows of the previous call the host accepted). If j + seg > L the committed entries are folded into the
+// checkpoint first (j = 0). The seg new entries are appended at [j, j + seg) but stay uncommitted (pos[h] = j), so a
+// rejected draft costs nothing: the next call's adv simply does not cover it and the slots are overwritten.
+// y_i = exp(cum[e]) C_i.h0 + sum_{k<=e} exp(cum[e]-cum[k]) dt_k (C_i.B_k) x_k with e = j + i, cum = prefix sums of dt*A.
+// Fold pass of the verify step: sequences whose committed entries plus this step's tokens overflow the cache fold the
+// committed entries into the checkpoint here (a separate kernel keeps the verify kernel's register count low), and
+// store pos = -adv so the verify kernel's j = pos + adv starts at 0.
+template <int L>
+static __global__ void __launch_bounds__(128) ssm_replay_fold(
+        half * __restrict__ rows, const int64_t row_stride, const int64_t S, const float * __restrict__ A,
+        const int64_t A_h, const int32_t * __restrict__ offsets, const int H, const int G, const int32_t * __restrict__ ids,
+        const int n_seq, const int maxt) {
+    constexpr int P = 64, N = 128;
+    const int seq = blockIdx.x, h = blockIdx.y, g = h / (H / G);
+    const int tid = threadIdx.x, lane = tid % WARP_SIZE, warp = tid / WARP_SIZE;
+    const int seg = min((int) (offsets[seq + 1] - offsets[seq]), maxt);
+    const int rid = ids[seq], wid = ids[n_seq + seq], adv = ids[2 * n_seq + seq];
+    if (rid != wid) return;
+    half * row = rows + (int64_t) wid * row_stride;
+    half * h0 = row + (int64_t) h * P * N;
+    half * pos = row + S;
+    const int j = min(max((int) __half2float(pos[h]) + adv, 0), L);
+    if (j + seg <= L) return;
+    const float * dtc = (const float *) (row + S + H);
+    const half * xc = row + S + H + 2 * L * H;
+    const half * bc = xc + (int64_t) L * H * P;
+    const float a = A[h * A_h];
+    __shared__ float s_x[L][P];  // dd_k * x_k[p]
+    __shared__ float s_dd[L], s_d[L], s_tot;
+    if (tid < j) s_d[tid] = dtc[tid * H + h];  // parallel loads; the scan below runs on shared memory
+    __syncthreads();
+    if (tid == 0) {
+        float dec = 1.0f;  // exp(sum_{m=k+1..j-1} dA_m)
+        for (int k = j - 1; k >= 0; --k) {
+            s_dd[k] = dec * s_d[k];
+            dec *= __expf(s_d[k] * a);
+        }
+        s_tot = dec;
+    }
+    __syncthreads();
+    for (int i = tid; i < j * P; i += blockDim.x) {
+        const int k = i / P, p = i % P;
+        s_x[k][p] = s_dd[k] * __half2float(xc[(int64_t) k * H * P + h * P + p]);
+    }
+    // B_k columns of this lane (4 consecutive n), 8-byte loads
+    float bk[L][4];
+#pragma unroll
+    for (int k = 0; k < L; ++k) {
+        if (k < j) {
+            const uint2 v = *(const uint2 *) (bc + (int64_t) k * G * N + g * N + lane * 4);
+            const half2 * hh = (const half2 *) &v;
+            const float2 f0 = __half22float2(hh[0]), f1 = __half22float2(hh[1]);
+            bk[k][0] = f0.x; bk[k][1] = f0.y; bk[k][2] = f1.x; bk[k][3] = f1.y;
+        } else {
+            bk[k][0] = bk[k][1] = bk[k][2] = bk[k][3] = 0.0f;
+        }
+    }
+    __syncthreads();
+    const float total = s_tot;
+    // all of this warp's checkpoint rows are loaded up front (independent loads in flight)
+    constexpr int RPW = P / 4;
+#pragma unroll
+    for (int r = 0; r < RPW; ++r) {
+        const int p = warp + 4 * r;
+        float v[4];
+#pragma unroll
+        for (int q = 0; q < 4; ++q) v[q] = total * __half2float(h0[(int64_t) p * N + lane * 4 + q]);
+#pragma unroll
+        for (int k = 0; k < L; ++k) {
+            const float xk = k < j ? s_x[k][p] : 0.0f;
+#pragma unroll
+            for (int q = 0; q < 4; ++q) v[q] += xk * bk[k][q];
+        }
+#pragma unroll
+        for (int q = 0; q < 4; ++q) h0[(int64_t) p * N + lane * 4 + q] = __float2half(v[q]);
+    }
+    __syncthreads();
+    if (tid == 0) pos[h] = __float2half((float) -adv);
+}
