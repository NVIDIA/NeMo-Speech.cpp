+template <int L, int MAXT>
+static __global__ void __launch_bounds__(128) ssm_replay_verify(
+        half * __restrict__ rows, const int64_t row_stride, const int64_t S,
+        const float * __restrict__ x, const int64_t x_tok, const float * __restrict__ dt, const int64_t dt_tok,
+        const float * __restrict__ A, const int64_t A_h, const float * __restrict__ B, const int64_t B_tok,
+        const float * __restrict__ C, const int64_t C_tok, const int32_t * __restrict__ offsets,
+        float * __restrict__ y, const int H, const int G, const int32_t * __restrict__ ids, const int n_seq) {
+    constexpr int P = 64, N = 128;
+    const int seq = blockIdx.x, h = blockIdx.y, g = h / (H / G);
+    const int tid = threadIdx.x, lane = tid % WARP_SIZE, warp = tid / WARP_SIZE;
+    const int64_t t0 = offsets[seq];
+    const int seg = min((int) (offsets[seq + 1] - t0), MAXT);
+    const int rid = ids[seq], wid = ids[n_seq + seq], adv = ids[2 * n_seq + seq];
+    half * row = rows + (int64_t) wid * row_stride;
+    half * h0 = row + (int64_t) h * P * N;
+    half * pos = row + S;
+    float * dtc = (float *) (row + S + H);
+    half * xc = row + S + H + 2 * L * H;
+    half * bc = xc + (int64_t) L * H * P;
+    const float a = A[h * A_h];
+
+    // ~5 KB of shared memory at MAXT = 4 (occupancy: the kernel is a state-streaming one)
+    __shared__ float s_C[MAXT][N], s_Bn[MAXT][N], s_ch[MAXT][P];
+    __shared__ float s_dt[L], s_cum[L], s_coef[MAXT][L], s_dtn[MAXT], s_tot[MAXT];
+    __shared__ int s_j;
+
+    if (tid == 0) {
+        const int j = rid == wid ? (int) __half2float(pos[h]) + adv : 0;  // a fresh cell (read row != write row) starts empty
+        s_j = min(max(j, 0), L);
+    }
+    __syncthreads();
+    int j = s_j;
+
+    if (rid != wid) {
+        // fresh cell: zero checkpoint (the cache entries are unused at j = 0)
+        for (int e = tid; e < P * N; e += blockDim.x) h0[e] = __float2half(0.0f);
+        __syncthreads();
+    }
+
+    for (int i = 0; i < seg; ++i) {
+        s_C[i][tid]  = C[(t0 + i) * C_tok + g * N + tid];
+        s_Bn[i][tid] = B[(t0 + i) * B_tok + g * N + tid];
+    }
+    if (tid < seg) {
+        const float d = dt[(t0 + tid) * dt_tok + h];
+        s_dtn[tid] = d <= 20.0f ? log1pf(expf(d)) : d;
+    }
+    __syncthreads();
+    // dt over the window [0, j + seg): committed entries from the cache, then the new tokens
+    const int E = j + seg;
+    if (tid < j) s_dt[tid] = dtc[tid * H + h];
+    else if (tid < E) s_dt[tid] = s_dtn[tid - j];
+    __syncthreads();
+    if (tid == 0) {
+        float c = 0.0f;
+        for (int k = 0; k < E; ++k) { c += s_dt[k] * a; s_cum[k] = c; }
+    }
+    // coef[i][k] = exp(cum[e]-cum[k]) dt_k (C_i.B_k) for k <= e = j + i (one warp per pair for the dot product)
+    for (int pr = warp; pr < seg * E; pr += 4) {
+        const int i = pr / E, k = pr % E;
+        float acc = 0.0f;
+        if (k <= j + i) {
+            for (int n = lane; n < N; n += WARP_SIZE) {
+                const float bkv = k < j ? __half2float(bc[(int64_t) k * G * N + g * N + n]) : s_Bn[k - j][n];
+                acc += bkv * s_C[i][n];
+            }
+            acc = warp_reduce_sum(acc);
+        }
+        __syncwarp();
+        if (lane == 0) s_coef[i][k] = acc;  // C.B for now, scaled below
+    }
+    __syncthreads();
+    for (int t = tid; t < seg * E; t += blockDim.x) {  // seg * E exceeds the block from MAXT 9 (E <= L)
+        const int i = t / E, k = t % E;
+        s_coef[i][k] = k <= j + i ? expf(s_cum[j + i] - s_cum[k]) * s_dt[k] * s_coef[i][k] : 0.0f;
+    }
+    if (tid < seg) s_tot[tid] = expf(s_cum[j + tid]);
+
+    // C_i . h0 (16 lanes per state row, two rows per warp per iteration): the checkpoint is read once for all tokens
+    const int l16 = lane & 15;
+#pragma unroll 2
+    for (int it = 0; it < P / 8; ++it) {
+        const int p = warp * (P / 4) + it * 2 + (lane >> 4);
+        float hv[8];
+        const uint4 v = ((const uint4 *) (h0 + (int64_t) p * N))[l16];
+        const half2 * hh = (const half2 *) &v;
+#pragma unroll
+        for (int q = 0; q < 4; ++q) { const float2 f = __half22float2(hh[q]); hv[2*q] = f.x; hv[2*q+1] = f.y; }
+#pragma unroll
+        for (int i = 0; i < MAXT; ++i) {
+            float acc = 0.0f;
+            if (i < seg) {
+#pragma unroll
+                for (int q = 0; q < 8; ++q) acc += hv[q] * s_C[i][l16 * 8 + q];
+            }
+#pragma unroll
+            for (int off = 8; off > 0; off >>= 1) acc += __shfl_xor_sync(0xffffffff, acc, off);
+            if (l16 == 0 && i < seg) s_ch[i][p] = acc;
+        }
+    }
+    __syncthreads();
+    if (tid < P) {
+        float yx[MAXT];
+#pragma unroll
+        for (int i = 0; i < MAXT; ++i) yx[i] = 0.0f;
+        for (int k = 0; k < E; ++k) {
+            const float xk = k < j ? __half2float(xc[(int64_t) k * H * P + h * P + tid]) : x[(t0 + k - j) * x_tok + h * P + tid];
+#pragma unroll
+            for (int i = 0; i < MAXT; ++i) yx[i] += i < seg ? s_coef[i][k] * xk : 0.0f;
+        }
+#pragma unroll
+        for (int i = 0; i < MAXT; ++i) {
+            if (i < seg) {
+                y[(t0 + i) * H * P + h * P + tid] = s_tot[i] * s_ch[i][tid] + yx[i];
+                xc[(int64_t) (j + i) * H * P + h * P + tid] = __float2half(x[(t0 + i) * x_tok + h * P + tid]);
+            }
+        }
+    }
+    for (int i = 0; i < seg; ++i) bc[(int64_t) (j + i) * G * N + g * N + tid] = __float2half(s_Bn[i][tid]);
+    if (tid < seg) dtc[(j + tid) * H + h] = s_dtn[tid];
+    if (tid == 0) pos[h] = __float2half((float) j);  // the new entries stay uncommitted until the next call's adv
+}
