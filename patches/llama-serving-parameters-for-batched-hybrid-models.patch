From: Prabhsimran Singh <prabhsimrans@nvidia.com>
Subject: llama: serving parameters for batched hybrid models

llama_context_params.serving (llama_serving_params) selects the
high-throughput path for hybrid Mamba-2 + attention models that the following
patches implement: batched (ragged batches, in-place recurrent state, device
KQ masks, batched greedy outputs), mtp_replay (tokens per MTP verify step),
kv_bucket and kv_reserve_cells, and cuda_serving
(ggml_backend_cuda_serving applied to the context's CUDA backends when they
are created). All zero is upstream behavior.
llama_get_serving_params() returns a context's parameters.

Upstream: not planned (NeMo serving path).

diff --git a/include/llama.h b/include/llama.h
index 31bbf8b0d98726a4c4627ce415f0cac9395ad996..cb44212bbbec65af3f64402da3893bbdabf1bbd1 100644
--- a/include/llama.h
+++ b/include/llama.h
@@ -355,6 +355,24 @@ extern "C" {
         struct llama_sampler * sampler;
     };
 
+    // High-throughput serving of hybrid (Mamba-2 + attention) models such as Nemotron-H for NeMo-Speech.cpp's speech-LLM
+    // engine. All zero (the default) is upstream behavior.
+    struct llama_serving_params {
+        // Ragged batches (sequences of different lengths in one ubatch); in-place F16 recurrent state with one pinned
+        // cell per sequence, ReplaySSM rows for one-token decode and chunked SSD for long segments; KQ masks built on the
+        // device from per-sequence cell lists (flash attention, unified KV); batched greedy argmax outputs. CUDA devices
+        // need compute capability 8.0 or newer (context creation fails otherwise).
+        bool     batched;
+        // Tokens per MTP verify step (drafts + 1, at most the 16 ReplaySSM cache rows; needs batched); 0 = no MTP verify steps.
+        int32_t  mtp_replay;
+        // Pad the KV length to a multiple of this so that decode graphs are reused (0: 256).
+        uint32_t kv_bucket;
+        // Cap on the KV cells covered by the attention masks reserved at init (0: all cells).
+        uint32_t kv_reserve_cells;
+        // struct ggml_backend_cuda_serving (ggml-cuda.h) applied to the context's CUDA backends, or NULL.
+        const void * cuda_serving;
+    };
+
     // NOTE: changing the default values of parameters marked as [EXPERIMENTAL] may cause crashes or incorrect results in certain configurations
     //       https://github.com/ggml-org/llama.cpp/pull/7544
     struct llama_context_params {
@@ -417,6 +435,8 @@ extern "C" {
         // a source/target/parent context
         // can be utilized in various ways, for example by sharing results or llama_memory between 2 contexts
         struct llama_context * ctx_other;
+
+        struct llama_serving_params serving;
     };
 
     struct llama_model_tensor_override {
diff --git a/src/llama-context.cpp b/src/llama-context.cpp
index fcd4dfb13b10ab5f46b453e48cbf4b047154c684..f94865905a0a1be3b1a332d88b64eed66d6517bc 100644
--- a/src/llama-context.cpp
+++ b/src/llama-context.cpp
@@ -272,6 +272,7 @@ llama_context::llama_context(
 
     cparams.op_offload = params.op_offload;
     cparams.kv_unified = params.kv_unified;
+    cparams.serving    = params.serving;
 
     // initialized later
     cparams.pipeline_parallel = false;
@@ -335,6 +336,26 @@ llama_context::llama_context(
             if (backend == nullptr) {
                 throw std::runtime_error(format("failed to initialize %s backend", ggml_backend_dev_name(dev.dev)));
             }
+            if (params.serving.batched) {
+                // the batched path's CUDA kernels (ragged Mamba2, chunked SSD, MTP verify) need compute capability 8.0+
+                using supported_t = bool (*)(ggml_backend_t);
+                auto supported = (supported_t) ggml_backend_reg_get_proc_address(
+                    ggml_backend_dev_backend_reg(dev.dev), "ggml_backend_cuda_serving_supported");
+                if (supported && !supported(backend)) {
+                    ggml_backend_free(backend);
+                    throw std::runtime_error(format("batched serving needs an NVIDIA GPU of compute capability 8.0 or newer (%s)",
+                            ggml_backend_dev_name(dev.dev)));
+                }
+            }
+            if (params.serving.cuda_serving) {
+                // serving kernels for this context's CUDA backends (before any graph is reserved)
+                using set_serving_t = void (*)(ggml_backend_t, const void *);
+                auto set_serving = (set_serving_t) ggml_backend_reg_get_proc_address(
+                    ggml_backend_dev_backend_reg(dev.dev), "ggml_backend_cuda_set_serving");
+                if (set_serving) {
+                    set_serving(backend, params.serving.cuda_serving);
+                }
+            }
             backends.emplace_back(backend);
         }
 
@@ -3731,6 +3752,7 @@ llama_context_params llama_context_default_params() {
         /*.sampler                     =*/ nullptr,
         /*.n_sampler                   =*/ 0,
         /*.ctx_other                   =*/ nullptr,
+        /*.serving                     =*/ {},
     };
 
     return result;
@@ -3971,6 +3993,10 @@ void llama_set_embeddings_nextn(llama_context * ctx, bool value, bool masked) {
     ctx->set_embeddings_nextn(value, masked);
 }
 
+llama_serving_params llama_get_serving_params(const llama_context * ctx) {
+    return ctx->get_cparams().serving;
+}
+
 void llama_set_embeddings_layer_inp(llama_context * ctx, uint32_t lid, bool value) {
     ctx->set_embeddings_layer_inp(lid, value);
 }
