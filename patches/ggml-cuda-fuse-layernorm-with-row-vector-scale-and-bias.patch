diff --git a/ggml/src/ggml-cuda/norm.cu b/ggml/src/ggml-cuda/norm.cu
index c3758cd50cfeae5d94621ada986d18e268faf8a4..8d2c036b6b414d8ba4d05b61382855b3da4a99b0 100644
--- a/ggml/src/ggml-cuda/norm.cu
+++ b/ggml/src/ggml-cuda/norm.cu
@@ -38,6 +38,50 @@ static __global__ void norm_f32(
     }
