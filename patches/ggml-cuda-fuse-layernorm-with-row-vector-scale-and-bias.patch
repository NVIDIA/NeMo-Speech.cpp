+        const int nchannels, const int nsamples, const int64_t stride_row, const int64_t stride_channel,
+        const int64_t stride_sample, const float eps, cudaStream_t stream) {
+    const dim3 blocks_num(nrows, nchannels, nsamples);
+    if (ncols < 1024) {
+        const dim3 block_dims(WARP_SIZE, 1, 1);
+        if (add) {
+            norm_mul_add_f32<WARP_SIZE, true><<<blocks_num, block_dims, 0, stream>>>(
+                x, mul, add, dst, ncols, stride_row, stride_channel, stride_sample, eps);
+        } else {
+            norm_mul_add_f32<WARP_SIZE, false><<<blocks_num, block_dims, 0, stream>>>(
+                x, mul, add, dst, ncols, stride_row, stride_channel, stride_sample, eps);
+        }
+    } else {
+        const dim3 block_dims(1024, 1, 1);
+        if (add) {
+            norm_mul_add_f32<1024, true><<<blocks_num, block_dims, 32 * sizeof(float2), stream>>>(
+                x, mul, add, dst, ncols, stride_row, stride_channel, stride_sample, eps);
+        } else {
+            norm_mul_add_f32<1024, false><<<blocks_num, block_dims, 32 * sizeof(float2), stream>>>(
+                x, mul, add, dst, ncols, stride_row, stride_channel, stride_sample, eps);
+        }
+    }
+}
