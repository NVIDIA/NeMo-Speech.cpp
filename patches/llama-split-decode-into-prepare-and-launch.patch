+int llama_context::decode_prepare(const llama_batch & batch_inp) {
+    GGML_ASSERT(!pend.active && "llama_decode_prepare: a prepared decode is pending");
+    GGML_ASSERT(memory && batch_inp.token && !batch_inp.embd && !batch_inp.embd_input && batch_inp.logits);
+    GGML_ASSERT(!cparams.embeddings && cparams.ctx_type == LLAMA_CONTEXT_TYPE_DEFAULT);
+    if (batch_inp.n_tokens == 0) {
+        return -1;
+    }
+    const uint32_t n_seq_max = cparams.kv_unified ? LLAMA_MAX_SEQ : cparams.n_seq_max;
+    if (!balloc->init(batch_inp, model.vocab, memory.get(), model.hparams.n_embd_inp(), n_seq_max, false)) {
+        return -1;
+    }
+    const uint32_t n_tokens_all  = balloc->get_n_tokens();
+    const uint32_t n_outputs_all = balloc->get_n_outputs();
+    GGML_ASSERT(n_tokens_all <= cparams.n_ubatch && "llama_decode_prepare: single-ubatch batches only");
+    if (t_compute_start_us == 0) {
+        t_compute_start_us = ggml_time_us();
+    }
+    n_queued_tokens += n_tokens_all;
+    sched_reserve();
+    memory_update(false);
+    llama_memory_context_ptr mctx = memory->init_batch(*balloc, cparams.n_ubatch, false);
+    if (!mctx || mctx->get_status() != LLAMA_MEMORY_STATUS_SUCCESS) {
+        return -2;
+    }
+    const auto & ubatch = mctx->get_ubatch();
+    GGML_ASSERT(ubatch.n_tokens == n_tokens_all && "llama_decode_prepare: the batch must form one ubatch");
+    GGML_ASSERT(ubatch.token_indices == nullptr || [&]() {
+        for (uint32_t i = 0; i < ubatch.n_tokens; ++i) if (ubatch.token_indices[i] != (int32_t) i) return false;
+        return true; }());
+    int32_t n_outputs_new = 0;
+    if (n_outputs_all == n_tokens_all) {
+        n_outputs_new = ubatch.n_tokens;
+    } else {
+        for (uint32_t i = 0; i < ubatch.n_tokens; i++) n_outputs_new += (int32_t) (ubatch.output[i] != 0);
+    }
+    // the previous decode's outputs stay readable until launch: n_outputs is only borrowed for the graph build
+    const int32_t n_outputs_keep = n_outputs;
+    n_outputs = n_outputs_new;
+    ggml_status status;
+    llm_graph_result * res = process_ubatch_prepare(ubatch, LLM_GRAPH_TYPE_DEFAULT, mctx.get(), status);
+    n_outputs = n_outputs_keep;
+    if (!res) {
+        rollback_ubatch(memory.get(), ubatch);
+        return -3;
+    }
+    pend.active        = true;
+    pend.mctx          = std::move(mctx);
+    pend.res           = res;
+    pend.n_tokens_all  = n_tokens_all;
+    pend.n_outputs_all = n_outputs_all;
+    pend.n_outputs     = n_outputs_new;
+    return 0;
+}
+
+int llama_context::decode_launch(const llama_token * tokens, int32_t n_tokens) {
+    GGML_ASSERT(pend.active && "llama_decode_launch: nothing prepared");
+    llm_graph_result * res = pend.res;
+    const auto & ubatch = pend.mctx->get_ubatch();
+    if (tokens) {
+        GGML_ASSERT(n_tokens == (int32_t) ubatch.n_tokens && res->get_inp_tokens());
+        ggml_backend_tensor_set(res->get_inp_tokens(), tokens, 0, n_tokens * sizeof(llama_token));
+    }
+    output_swaps.clear();
+    if (output_reserve(pend.n_outputs_all) < pend.n_outputs_all) {
+        rollback_ubatch(memory.get(), ubatch);
+        pend = {};
+        return -2;
+    }
+    for (const auto & entry : sampling.samplers) {
+        llama_sampler_backend_begin(entry.second);
+    }
+    nextn_device_rows  = pend.n_tokens_all;
+    nextn_host_current = false;
+    n_outputs = pend.n_outputs;
+    const auto status = graph_compute(res->get_gf(), ubatch.n_tokens > 1);
+    if (status != GGML_STATUS_SUCCESS) {
+        rollback_ubatch(memory.get(), ubatch);
+        pend = {};
+        return -3;
+    }
+    const int64_t n_vocab = model.vocab.n_tokens();
+    auto * t_logits = res->get_logits();
+    if (logits.data && t_logits && n_outputs > 0 && needs_raw_logits(ubatch, sampling.samplers)) {
+        ggml_backend_t backend_res = ggml_backend_sched_get_tensor_backend(sched.get(), t_logits);
+        ggml_backend_tensor_get_async(backend_res, t_logits, logits.data, 0, n_outputs*n_vocab*sizeof(float));
+    }
+    extract_layer_inputs(res, 0, ubatch.n_tokens);
+    if (!sampling.samplers.empty()) {
+        copy_tensor_async_rows(res->t_sampled,        sampling.sampled,    1,       0, sched.get());
+        copy_tensor_async_rows(res->t_sampled_logits, sampling.logits,     n_vocab, 0, sched.get(), &sampling.logits_count);
+        copy_tensor_async_rows(res->t_sampled_probs,  sampling.probs,      n_vocab, 0, sched.get(), &sampling.probs_count);
+        copy_tensor_async_rows(res->t_candidates,     sampling.candidates, n_vocab, 0, sched.get(), &sampling.candidates_count);
+    }
+    n_outputs = pend.n_outputs_all;
+    if (n_outputs > 0) {
+        auto & out_ids = balloc->get_out_ids();
+        GGML_ASSERT(out_ids.size() == (size_t) n_outputs);
+        bool sorted_output = true;
+        for (int64_t i = 0; i < n_outputs; ++i) {
+            output_ids[out_ids[i]] = i;
+            sorted_output &= out_ids[i] == i;
+        }
+        GGML_ASSERT(sorted_output && "llama_decode_launch: outputs must be in batch order");
+    }
+    pend = {};
+    return 0;
+}
