+// A prepared decode that fails after the memory took its ubatch (apply): remove the ubatch's positions, as decode()
+// does for a failed ubatch, so later batches at those positions are accepted and no cell claims an unwritten row.
+static void rollback_ubatch(llama_memory_i * memory, const llama_ubatch & ubatch) {
+    std::unordered_map<llama_seq_id, llama_pos> pos_min;
+    for (uint32_t i = 0; i < ubatch.n_tokens; ++i) {
+        const llama_seq_id s = ubatch.seq_id[i][0];
+        const auto it = pos_min.find(s);
+        if (it == pos_min.end() || ubatch.pos[i] < it->second) {
+            pos_min[s] = ubatch.pos[i];
+        }
+    }
+    for (const auto & [s, p] : pos_min) {
+        LLAMA_LOG_WARN("%s: removing memory module entries for seq_id = %d, pos = [%d, +inf)\n", __func__, s, p);
+        memory->seq_rm(s, p, -1);
+    }
+}
