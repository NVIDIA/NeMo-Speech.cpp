+void llama_context::set_mtp_verify(bool verify) {
+    mtp_verify = verify;
+    llama_memory_recurrent * recr = dynamic_cast<llama_memory_recurrent *>(memory.get());
+    if (auto * hybrid = dynamic_cast<llama_memory_hybrid *>(memory.get())) {
+        recr = hybrid->get_mem_recr();
+    }
+    if (recr) {
+        recr->mtp_verify = verify;
+    }
+}
+
+void llama_set_mtp_verify(llama_context * ctx, bool verify) {
+    ctx->set_mtp_verify(verify);
+}
