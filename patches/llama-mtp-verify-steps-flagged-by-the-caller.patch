     LLAMA_API int32_t llama_decode_launch(struct llama_context * ctx, const llama_token * tokens, int32_t n_tokens);
 
+    // Batched serving with mtp_replay: whether the following decodes are MTP verify steps (each sequence's last accepted
+    // token and its drafts, at most mtp_replay rows; they stay uncommitted until the next verify step accepts them).
+    // Every other decode (prefill) commits its rows. Off by default.
+    LLAMA_API void llama_set_mtp_verify(struct llama_context * ctx, bool verify);
+
     // Set the number of threads used for decoding
     // n_threads is the number of threads used for generation (single token)
     // n_threads_batch is the number of threads used for prompt and batch processing (multiple tokens)
