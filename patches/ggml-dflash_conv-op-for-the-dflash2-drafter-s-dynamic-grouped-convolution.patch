diff --git a/ggml/src/ggml-cuda/dflash-conv.cu b/ggml/src/ggml-cuda/dflash-conv.cu
new file mode 100644
index 0000000000000000000000000000000000000000..a5fc5cd2998fd87e57816083da9900c41c62b966
--- /dev/null
+++ b/ggml/src/ggml-cuda/dflash-conv.cu
@@ -0,0 +1,53 @@
+#include "dflash-conv.cuh"
+
+// DFlash2 dynamic grouped convolution (ggml_dflash_conv): one thread per (channel, token), taps unrolled for k <= 4.
+template <int K>
+static __global__ void dflash_conv_f32(const float * __restrict__ x, const char * __restrict__ coef,
+        const char * __restrict__ base, float * __restrict__ y, const int64_t n_embd, const int64_t group,
+        const int block, const size_t c0, const size_t c1, const size_t c2, const size_t b0, const size_t b1, int k) {
+    const int64_t h = (int64_t) blockIdx.x*blockDim.x + threadIdx.x;
+    const int64_t t = blockIdx.y;
+    if (h >= n_embd) {
+        return;
+    }
+    const int pos = (int) (t % block);
+    const char * c = coef + (h/group)*c0 + t*c2;
+    const char * b = base + h*b0;
+    float acc = 0.0f;
+    const int kk = K > 0 ? K : k;
+#pragma unroll
+    for (int j = 0; j < (K > 0 ? K : 8); ++j) {
+        if (j >= kk) {
+            break;
+        }
+        if (pos >= j) {
+            const float w = *(const float *) (c + j*c1) + *(const float *) (b + j*b1);
+            acc += w*x[(t - j)*n_embd + h];
+        }
+    }
+    y[t*n_embd + h] = acc;
+}
+
+void ggml_cuda_op_dflash_conv(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * x    = dst->src[0];
+    const ggml_tensor * coef = dst->src[1];
+    const ggml_tensor * base = dst->src[2];
+    const int block = ggml_get_op_params_i32(dst, 0);
+    const int k = (int) coef->ne[1];
+    GGML_ASSERT(k >= 1 && k <= 8);
+    const int64_t n_embd = x->ne[0], n_tokens = x->ne[1];
+    const int64_t group = n_embd / coef->ne[0];
+    GGML_ASSERT(n_tokens <= 65535 && "DFLASH_CONV: grid y limit");
+    const dim3 grid((n_embd + 255)/256, n_tokens);
+    auto launch = [&](auto kernel) {
+        kernel<<<grid, 256, 0, ctx.stream()>>>((const float *) x->data, (const char *) coef->data,
+            (const char *) base->data, (float *) dst->data, n_embd, group, block, coef->nb[0], coef->nb[1],
+            coef->nb[2], base->nb[0], base->nb[1], k);
+    };
+    if (k == 2) {
+        launch(dflash_conv_f32<2>);
+    } else {
+        launch(dflash_conv_f32<0>);
+    }
+    CUDA_CHECK(cudaGetLastError());
+}
