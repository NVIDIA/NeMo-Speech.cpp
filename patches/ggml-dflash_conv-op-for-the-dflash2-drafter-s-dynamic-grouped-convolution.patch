+struct ggml_tensor * ggml_dflash_conv(
+        struct ggml_context * ctx, struct ggml_tensor * x, struct ggml_tensor * coef,
+        struct ggml_tensor * base, int block) {
+    GGML_ASSERT(x->type == GGML_TYPE_F32 && coef->type == GGML_TYPE_F32 && base->type == GGML_TYPE_F32);
+    GGML_ASSERT(ggml_is_contiguous(x) && x->ne[2] == 1 && x->ne[3] == 1 && block > 0 && x->ne[1] % block == 0);
+    GGML_ASSERT(coef->ne[2] == x->ne[1] && coef->ne[0] > 0 && x->ne[0] % coef->ne[0] == 0 && coef->ne[3] == 1);
+    GGML_ASSERT(base->ne[0] == x->ne[0] && base->ne[1] == coef->ne[1] && base->ne[2] == 1 && base->ne[3] == 1);
+    struct ggml_tensor * r = ggml_new_tensor(ctx, GGML_TYPE_F32, 2, x->ne);
+    r->op = GGML_OP_DFLASH_CONV;
+    r->src[0] = x;
+    r->src[1] = coef;
+    r->src[2] = base;
+    ggml_set_op_params_i32(r, 0, block);
+    return r;
+}
+
