-        ggml_tensor * am = ggml_argmax(ctx0, cur);
+        ggml_tensor * am = cparams.serving.bf16_argmax ? ggml_argmax_bf16(ctx0, cur) : ggml_argmax(ctx0, cur);
         ggml_build_forward_expand(gf, ggml_cpy(ctx0, am,
             ggml_view_1d(ctx0, cparams.mtp_tok, am->ne[0], cparams.mtp_tok_out*ggml_element_size(cparams.mtp_tok))));
         if (cparams.mtp_h_out) {
