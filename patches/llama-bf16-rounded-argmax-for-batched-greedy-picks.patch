@@ -206,7 +206,7 @@ llama_model_nemotron_h_moe::graph_mtp::graph_mtp(const llama_model & model, cons
     if (cparams.mtp_tok && cparams.mtp_tok_out >= 0) {
         // chained drafting: argmax ids and the head's hidden rows stay on the device for the next draft; nothing is
