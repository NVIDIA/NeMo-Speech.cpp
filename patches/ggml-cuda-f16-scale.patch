From: Prabhsimran Singh <prabhsimrans@nvidia.com>
Subject: ggml-cuda: F16 SCALE

SCALE (with its bias) also runs on F16 tensors, computing in F32. The batched
serving path clears the F16 recurrent-state rows of new sequences with a zero
scale (llama: ragged recurrent batches with in-place SSM state); the upstream
kernel accepts F32 only.

Upstream: candidate.

diff --git a/ggml/src/ggml-cuda/scale.cu b/ggml/src/ggml-cuda/scale.cu
index d9f1af8c3b6ffba577fc24ac9a0f30253961ad7b..10d36f45ca3e7a766b18572ca583a525d81da85d 100644
--- a/ggml/src/ggml-cuda/scale.cu
+++ b/ggml/src/ggml-cuda/scale.cu
@@ -1,39 +1,43 @@
 #include "scale.cuh"
+#include "convert.cuh"
 
 #define MAX_GRIDDIM_X 0x7FFFFFFF
 
-static __global__ void scale_f32(const float * x, float * dst, const float scale, const float bias, const int64_t nelements) {
+template <typename T>
+static __global__ void scale_f32(const T * x, T * dst, const float scale, const float bias, const int64_t nelements) {
     ggml_cuda_pdl_lc();
     int64_t tid = (int64_t)blockIdx.x * (int64_t)blockDim.x + (int64_t)threadIdx.x;
     int64_t stride = (int64_t)blockDim.x * (int64_t)gridDim.x;
 
     ggml_cuda_pdl_sync();
     for (int64_t i = tid; i < nelements; i += stride) {
-        dst[i] = scale * x[i] + bias;
+        dst[i] = ggml_cuda_cast<T>(scale * ggml_cuda_cast<float>(x[i]) + bias);
     }
 }
 
-static void scale_f32_cuda(const float * x, float * dst, const float scale, const float bias, const int64_t nelements, cudaStream_t stream) {
+template <typename T>
+static void scale_f32_cuda(const T * x, T * dst, const float scale, const float bias, const int64_t nelements, cudaStream_t stream) {
     const int64_t num_blocks = (nelements + CUDA_SCALE_BLOCK_SIZE - 1) / CUDA_SCALE_BLOCK_SIZE;
     const ggml_cuda_kernel_launch_params launch_params = ggml_cuda_kernel_launch_params(MIN(MAX_GRIDDIM_X, num_blocks), CUDA_SCALE_BLOCK_SIZE, 0, stream);
-    ggml_cuda_kernel_launch(scale_f32, launch_params, x, dst, scale, bias, nelements);
+    ggml_cuda_kernel_launch(scale_f32<T>, launch_params, x, dst, scale, bias, nelements);
 }
 
 void ggml_cuda_op_scale(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
     const ggml_tensor * src0 = dst->src[0];
-    const float * src0_d = (const float *)src0->data;
