+// extract nextn embeddings (hidden state before the final output norm) of one ubatch, to the host or the device
+// rows (llama_set_embeddings_nextn_device); only meaningful in LLAMA_POOLING_TYPE_NONE (per-token)
+void llama_context::extract_nextn(const llama_ubatch & ubatch, ggml_tensor * t_h_nextn, int64_t n_outputs,
+                                  int64_t n_outputs_prev, int64_t n_tokens_prev) {
+    const auto & hparams = model.hparams;
+    const bool masked    = cparams.embeddings_nextn_masked;
+    const int64_t n_rows = masked ? n_outputs       : (int64_t) ubatch.n_tokens;
+    const int64_t offset = masked ? n_outputs_prev  : n_tokens_prev;
+
+    if ((embd_nextn.data || use_nextn_device) && t_h_nextn && n_rows > 0 && cparams.pooling_type == LLAMA_POOLING_TYPE_NONE) {
+        ggml_backend_t backend_h = ggml_backend_sched_get_tensor_backend(sched.get(), t_h_nextn);
+        GGML_ASSERT(backend_h != nullptr);
+
+        const uint32_t n_embd  = hparams.n_embd_out();
+        float * embd_nextn_out = embd_nextn.data ? embd_nextn.data + offset*n_embd : nullptr;
+
+        GGML_ASSERT(use_nextn_device || (offset + n_rows)*n_embd <= (int64_t) embd_nextn.size);
+        if (use_nextn_device) {
+            GGML_ASSERT(!masked);
+            if (!nextn_device) {
+                ctx_nextn_device.reset(ggml_init({ggml_tensor_overhead(), nullptr, true}));
+                nextn_device = ggml_new_tensor_2d(ctx_nextn_device.get(), GGML_TYPE_F32, n_embd, cparams.n_batch);
+                buf_nextn_device.reset(ggml_backend_alloc_ctx_tensors(ctx_nextn_device.get(), backend_h));
+                GGML_ASSERT(buf_nextn_device);
+                nextn_device_backend = backend_h;
+            }
+            GGML_ASSERT(nextn_device_backend == backend_h);
+            for (int64_t i = 0; i < n_rows;) {
+                const int64_t dst_row = ubatch.token_indices ? ubatch.token_indices[i] : offset+i;
+                int64_t end = i+1;
+                while (end < n_rows && (!ubatch.token_indices || ubatch.token_indices[end] == dst_row+end-i)) ++end;
+                auto src = llama_tensor_row_view(t_h_nextn, i, end-i);
+                auto dst = llama_tensor_row_view(nextn_device, dst_row, end-i);
+                ggml_backend_tensor_copy_async(backend_h, backend_h, &src, &dst);
+                i = end;
+            }
+        } else if (!masked && ubatch.token_indices) {
+            // Dense hidden states are indexed by the original batch, not micro-batch order.
+            const size_t row_bytes = n_embd*sizeof(float);
+            for (int64_t i = 0; i < n_rows;) {
+                int64_t end = i + 1;
+                while (end < n_rows && ubatch.token_indices[end] == ubatch.token_indices[i] + end - i) ++end;
+                ggml_backend_tensor_get_async(backend_h, t_h_nextn,
+                        embd_nextn.data + (size_t) ubatch.token_indices[i]*n_embd,
+                        i*row_bytes, (end-i)*row_bytes);
+                i = end;
+            }
+        } else {
+            ggml_backend_tensor_get_async(backend_h, t_h_nextn, embd_nextn_out, 0, n_rows*n_embd*sizeof(float));
+        }
+    }
+}
