--- a/ggml/src/ggml-cuda/im2col.cu
+++ b/ggml/src/ggml-cuda/im2col.cu
@@ -1,4 +1,5 @@
 #include "im2col.cuh"
+#include "convert.cuh"
 
 #define MAX_GRIDDIM_Y 65535
 #define MAX_GRIDDIM_Z 65535
@@ -44,12 +45,72 @@ static  __global__ void im2col_kernel(
