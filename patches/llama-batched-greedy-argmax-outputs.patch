diff --git a/src/llama-graph.cpp b/src/llama-graph.cpp
index 2dc4e8f82b8e03e17f592a0e58849f3ed758417f..aee9ee4b3dc59a2e96274209b23db5e64341a286 100644
--- a/src/llama-graph.cpp
+++ b/src/llama-graph.cpp
@@ -3944,6 +3944,52 @@ void llm_graph_context::build_sampling() const {
     res->t_sampled_logits.resize(n_rows, nullptr);
     res->t_candidates.resize(n_rows, nullptr);
 
+    // Batched serving: one argmax over all output rows serves every greedy sequence, without per-sequence
+    // sampler graphs or full-vocabulary D2H transfers. Only sequences with another sampler (temperature
+    // sampling) get their own sampler graph, on their rows only.
+    if (n_rows > 0 && cparams.serving.batched) {
+        auto is_greedy = [](llama_sampler * sampler) {
+            if (std::strcmp(llama_sampler_name(sampler), "chain") == 0) {
+                if (llama_sampler_chain_n(sampler) != 1) return false;
+                sampler = llama_sampler_chain_get(sampler, 0);
+            }
+            const char * name = llama_sampler_name(sampler);
+            if (name[0] == '+') ++name;
+            return std::strcmp(name, "greedy") == 0;
+        };
+        auto * ids = ggml_argmax(ctx0, res->t_logits);
+        ggml_set_name(ids, "batched_greedy_argmax");
+        ggml_set_output(ids);
+        ggml_build_forward_expand(gf, ids);
+        for (const auto & [seq_id, rows] : sampling_rows) {
+            const auto it = samplers.find(seq_id);
+            if (it == samplers.end()) continue;  // no sampler: the host reads the logits
+            auto * sampler = it->second;
+            if (is_greedy(sampler)) {
+                // per-row views for the output copy (it reads view_src + view_offs), kept out of the graph: one
+                // view node per row made the node count follow the lane count, so every decode step re-planned
+                // (and synchronized) the allocator
+                for (uint32_t row : rows) {
+                    res->t_sampled[row] = ggml_view_1d(ctx0, ids, 1, row*sizeof(llama_token));
+                }
+                continue;
+            }
+            if (sampler->iface->backend_reset) {
+                sampler->iface->backend_reset(sampler);
+            }
+            for (uint32_t row : rows) {
+                ggml_tensor * logits_row = ggml_view_1d(ctx0, res->t_logits, res->t_logits->ne[0], row*res->t_logits->nb[1]);
+                llama_sampler_data data = { logits_row, nullptr, nullptr, nullptr };
+                sampler->iface->backend_apply(sampler, ctx0, gf, &data);
+                if (data.sampled != nullptr) {
+                    res->t_sampled[row] = data.sampled;
+                    ggml_build_forward_expand(gf, data.sampled);
+                }
+            }
+        }
+        return;
+    }
+
     // res->t_logits will contain logits for all tokens that want the logits calculated (logits=1 or output=1)
     GGML_ASSERT(res->t_logits != nullptr && "missing t_logits tensor");
 
