+bool llama_sampler_backend_dist_rows(llama_sampler * smpl, float * inv_temp) {
+    if (smpl->iface != &llama_sampler_chain_i) {
+        return false;
+    }
+    const auto * chain = (const llama_sampler_chain *) smpl->ctx;
+    const size_t n = chain->samplers.size();
+    if (n < 1 || n > 2) {
+        return false;
+    }
+    for (const auto & entry : chain->samplers) {
+        if (!entry.is_backend) {
+            return false;
+        }
+    }
+    if (chain->samplers[n - 1].ptr->iface != &llama_sampler_dist_i) {
+        return false;
+    }
+    *inv_temp = 1.0f;
+    if (n == 2) {
+        if (chain->samplers[0].ptr->iface != &llama_sampler_temp_i) {
+            return false;
+        }
+        const float temp = ((const llama_sampler_temp *) chain->samplers[0].ptr->ctx)->temp;
+        if (temp <= 0.0f) {
+            return false;  // the temperature sampler's greedy form
+        }
+        *inv_temp = 1.0f / temp;
+    }
+    return true;
+}
+
+void llama_sampler_backend_dist_add_row(llama_sampler * smpl, ggml_tensor * uniforms, int64_t i) {
+    const auto * chain = (const llama_sampler_chain *) smpl->ctx;
+    auto * sctx = (llama_sampler_dist *) chain->samplers.back().ptr->ctx;
+    sctx->inp_uniform_rows.emplace_back(uniforms, i);
+}
