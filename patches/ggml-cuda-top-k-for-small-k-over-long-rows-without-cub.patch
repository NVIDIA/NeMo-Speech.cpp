@@ -225,6 +329,9 @@ void ggml_cuda_op_top_k(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
     const int64_t    nrows = ggml_nrows(src0);
     const int64_t    k     = dst->ne[0];
     ggml_cuda_pool & pool  = ctx.pool();
+    if (top_k_small_rows_launch(src0_d, dst_d, ncols, nrows, k, stream)) {
+        return;
+    }
