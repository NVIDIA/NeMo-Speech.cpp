+// Small k over long rows (DFlash2 candidates: 16 of 131072 logits per drafted row), one block per row: each thread
+// keeps its K largest values sorted in registers, then K rounds of a block-wide argmax over the threads' list heads
+// emit the row's top K in descending order (ties: lower column first). CUB's top-k is one launch per row.
+template <int K>
+static __global__ void top_k_small_rows(const float * __restrict__ src, int * __restrict__ dst, const int ncols) {
+    const float4 * x = reinterpret_cast<const float4 *>(src + (int64_t) blockIdx.x*ncols);
+    float v[K];
+    int   c[K];
+#pragma unroll
+    for (int i = 0; i < K; ++i) {
+        v[i] = -INFINITY;
+        c[i] = INT_MAX;
+    }
+    auto insert = [&](float val, int col) {
+        if (!(val > v[K - 1])) {
+            return;
+        }
+#pragma unroll
+        for (int i = 0; i < K; ++i) {
+            if (val > v[i]) {
+                const float tv = v[i];
+                const int   tc = c[i];
+                v[i] = val;
+                c[i] = col;
+                val  = tv;
+                col  = tc;
+            }
+        }
+    };
+    for (int j = threadIdx.x; j < ncols/4; j += blockDim.x) {
+        const float4 q = x[j];
+        insert(q.x, 4*j + 0);
+        insert(q.y, 4*j + 1);
+        insert(q.z, 4*j + 2);
+        insert(q.w, 4*j + 3);
+    }
+
+    __shared__ float s_v[32];
+    __shared__ int   s_c[32];
+    __shared__ int   s_win;
+    const int lane = threadIdx.x % WARP_SIZE, warp = threadIdx.x / WARP_SIZE, n_warps = blockDim.x / WARP_SIZE;
+    for (int r = 0; r < K; ++r) {
+        float bv = v[0];
+        int   bc = c[0];
+#pragma unroll
+        for (int o = WARP_SIZE/2; o > 0; o >>= 1) {
+            const float ov = __shfl_xor_sync(0xffffffff, bv, o);
+            const int   oc = __shfl_xor_sync(0xffffffff, bc, o);
+            if (ov > bv || (ov == bv && oc < bc)) {
+                bv = ov;
+                bc = oc;
+            }
+        }
+        if (lane == 0) {
+            s_v[warp] = bv;
+            s_c[warp] = bc;
+        }
+        __syncthreads();
+        if (threadIdx.x == 0) {
+            for (int w = 1; w < n_warps; ++w) {
+                if (s_v[w] > bv || (s_v[w] == bv && s_c[w] < bc)) {
+                    bv = s_v[w];
+                    bc = s_c[w];
+                }
+            }
+            s_win = bc;
+            dst[(int64_t) blockIdx.x*K + r] = bc == INT_MAX ? 0 : bc;
+        }
+        __syncthreads();
+        if (c[0] == s_win && s_win != INT_MAX) {
+#pragma unroll
+            for (int i = 0; i < K - 1; ++i) {
+                v[i] = v[i + 1];
+                c[i] = c[i + 1];
+            }
+            v[K - 1] = -INFINITY;
+            c[K - 1] = INT_MAX;
+        }
+    }
+}
+
+static bool top_k_small_rows_launch(const float * src, int * dst, int64_t ncols, int64_t nrows, int64_t k,
+                                    cudaStream_t stream) {
+    if (ncols < 1024 || ncols % 4 != 0 || (uintptr_t) src % 16 != 0 || nrows > INT_MAX) {
+        return false;
+    }
+    switch (k) {
+        case 8:  top_k_small_rows<8> <<<nrows, 256, 0, stream>>>(src, dst, (int) ncols); break;
+        case 16: top_k_small_rows<16><<<nrows, 256, 0, stream>>>(src, dst, (int) ncols); break;
+        case 32: top_k_small_rows<32><<<nrows, 256, 0, stream>>>(src, dst, (int) ncols); break;
+        default: return false;
+    }
+    CUDA_CHECK(cudaGetLastError());
+    return true;
+}
+
+bool ggml_cuda_top_k_small_rows_supported(const ggml_tensor * op) {
+    const ggml_tensor * src = op->src[0];
+    const int64_t k = op->ne[0];
+    // the launch's preconditions: row r at src + r*ncols, read with 16-byte loads
+    return src->type == GGML_TYPE_F32 && src->ne[0] >= 1024 && src->ne[0] % 4 == 0 && (k == 8 || k == 16 || k == 32) &&
+           ggml_is_contiguous(src) && src->view_offs % 16 == 0;
+}
