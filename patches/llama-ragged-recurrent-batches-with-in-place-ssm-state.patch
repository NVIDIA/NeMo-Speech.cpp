+void llama_rs_fill_pinned(const llm_graph_input_rs * inp, const llama_ubatch * ubatch,
+                          const llama_memory_recurrent_context * rctx) {
+    // [read cells | write cells (| committed verify rows with mtp_replay)]
+    const uint32_t n_seqs = ubatch->n_seqs;
+    const bool mtp = rctx->get_mtp_maxt() > 0;
+    std::vector<int32_t> ids((mtp ? 3 : 2)*n_seqs);
+    rctx->pinned_ids(*ubatch, ids.data(), ids.data() + n_seqs, mtp ? ids.data() + 2*n_seqs : nullptr);  // the caller's context (inp->mctx is stale on graph reuse)
+    ggml_backend_tensor_set(inp->own_ids, ids.data(), 0, ids.size()*sizeof(int32_t));
+}
