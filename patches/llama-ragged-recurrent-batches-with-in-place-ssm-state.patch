+llama_ubatch llama_batch_allocr::split_ragged(uint32_t n_ubatch, uint32_t n_keep_tail) {
+    GGML_ASSERT(!has_cpl);
+    std::vector<int32_t> idxs;
+    std::vector<uint32_t> offsets = {0};
+    seq_set_t seen;
+    for (uint32_t i = 0; i < get_n_tokens(); ++i) {
+        if (used[i] || seen.test(batch.seq_id[i][0])) continue;
+        GGML_ASSERT(batch.n_seq_id[i] == 1);
+        seen.set(batch.seq_id[i][0]);
+        const auto & rows = seq_set_map.at(seq_set[i]);
+        std::vector<int32_t> pending;
+        for (int32_t row : rows) if (!used[row]) pending.push_back(row);
+        uint32_t take = std::min<uint32_t>(pending.size(), n_ubatch - idxs.size());
+        // Keep all rollback snapshots in the final segment of each sequence.
+        if (take < pending.size() && pending.size() - take < n_keep_tail) {
+            take = pending.size() > n_keep_tail ? pending.size() - n_keep_tail : 0;
+        }
+        if (!take) break;
+        for (uint32_t j = 0; j < take; ++j) {
+            idxs.push_back(pending[j]);
+            used[pending[j]] = true;
+            ++n_used;
+        }
+        offsets.push_back(idxs.size());
+        if (idxs.size() == n_ubatch) break;
+    }
+    if (idxs.empty()) return {};
+    // Equal segments (decode steps) stay ragged too: the equal-seqs Mamba path copies every state.
+    auto result = ubatch_add(idxs, idxs.size(), false);
+    result.n_seqs = offsets.size()-1;
+    result.n_seq_tokens = 0;
+    result.seq_offsets = std::move(offsets);
+    return result;
+}
+
