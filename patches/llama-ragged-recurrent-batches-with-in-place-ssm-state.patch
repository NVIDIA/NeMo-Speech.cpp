+// Chunk rows {segment, start, length, index in segment} for segments long enough for chunked SSD.
+// Must match GGML_SSM_SSD_CHUNK / GGML_SSM_SSD_MIN_LEN in ggml-cuda/ssm-ssd-ragged.cuh.
+int64_t llama_ssd_chunk_rows(const llama_ubatch & ubatch, int32_t * rows) {
+    constexpr int32_t chunk = 128, min_len = 64;
+    int64_t n = 0;
+    for (size_t s = 0; s + 1 < ubatch.seq_offsets.size(); ++s) {
+        const int32_t start = ubatch.seq_offsets[s], len = ubatch.seq_offsets[s+1] - start;
+        if (len < min_len) continue;
+        for (int32_t k = 0; k*chunk < len; ++k, ++n) {
+            if (rows) {
+                rows[4*n + 0] = (int32_t) s;
+                rows[4*n + 1] = start + k*chunk;
+                rows[4*n + 2] = std::min(chunk, len - k*chunk);
+                rows[4*n + 3] = k;
+            }
+        }
+    }
+    return n;
+}
