.git
# Nested submodule .git files (llama.cpp, third_party/*) become broken pointers
# once copied; exclude them so the build context stays small. CMake applies
# patches/ to a copy of the plain llama.cpp tree.
**/.git
.gitignore
.gitmodules
.cache
.claude
build/**
build-*/**
**/build/**
**/build-*/**
# Keep the tracked model index required by CMake, but never send local model
# weights through the Docker build context.
models/*
!models/index.json
core.*
**/__pycache__
**/*.pyc
# *.wav / *.gguf are intentionally NOT excluded because test fixtures may use
# them. The pre-commit large-file check guards against accidentally adding a
# model artifact to the repository.
