+// Warp-cooperative single-pass NVFP4 activation quantizer: a warp processes 64
+// elements (one per lane x 2), amax-reduces over each 16-lane sub-block, and
+// packs cooperatively - ~8x the threads of the per-sub-block scalar kernel.
+// Byte-identical to the scalar single-pass path (see quantize_nvfp4_selftest);
+// no scale search.
+static __global__ void quantize_mmq_nvfp4_warp(
+        const float * __restrict__ x, const int32_t * __restrict__ ids, void * __restrict__ vy,
+        const int64_t ne00, const int64_t s01, const int64_t s02, const int64_t s03,
+        const int64_t ne0, const int64_t ne1, const int64_t ne2) {
+#if defined(BLACKWELL_MMA_AVAILABLE)
+    const int lane = threadIdx.x;     // 0..31
+    const int nwarps = blockDim.y;
+    constexpr int vals_per_warp = 64;  // 4 sub-blocks of QK_NVFP4_SUB(16)
+    const int64_t warp_start = ((int64_t) blockIdx.y * nwarps + threadIdx.y) * vals_per_warp;
+    if (warp_start >= ne0) {
+        return;  // uniform across the warp - safe before the shuffles below
+    }
+
+    const int64_t i1 = blockIdx.x;
+    const int64_t i2 = blockIdx.z % ne2;
+    const int64_t i3 = blockIdx.z / ne2;
+    const int64_t i01 = ids ? ids[i1] : i1;
+    const int64_t base_pos = i3 * s03 + i2 * s02 + i01 * s01;
+    const int64_t blocks_per_col = (ne0 + QK_K - 1) / QK_K;
+    block_fp4_mmq * y = (block_fp4_mmq *) vy;
+
+    const int lin = lane & 15;  // lane within its 16-element sub-block group
+
+#pragma unroll
+    for (int b = 0; b < 2; ++b) {
+        const int64_t i0 = warp_start + (int64_t) b * 32 + lane;
+        const float v = (i0 < ne00) ? x[base_pos + i0] : 0.0f;
+
+        // amax over the 16-lane sub-block group (mask 8..1, not 16).
+        float amax = fabsf(v);
+#pragma unroll
+        for (int m = 8; m > 0; m >>= 1) {
+            amax = fmaxf(amax, __shfl_xor_sync(0xFFFFFFFF, amax, m, WARP_SIZE));
+        }
+        const uint8_t fp8_code = ggml_cuda_fp32_to_ue4m3(amax / 6.0f);
+        const float subblock_scale = ggml_cuda_ue4m3_to_fp32(fp8_code);
+        const float inv_scale = subblock_scale > 0.0f ? 0.5f / subblock_scale : 0.0f;
+
+        const uint8_t n = ggml_cuda_float_to_fp4_e2m1(v, inv_scale);
+        // byte (sub*8 + lin) = nibble[lin] | (nibble[lin+8] << 4); lin in 0..7
+        // pack two sub-blocks' nibbles. lin+8 stays inside the 16-lane group.
+        const int src = (lane & 16) | ((lane + 8) & 15);
+        const uint8_t hi = (uint8_t) __shfl_sync(0xFFFFFFFF, (int) n, src, WARP_SIZE);
+
+        const int64_t sub_start = i0 - lin;  // sub-block start (16-aligned)
+        const int64_t gsub = i0 / QK_NVFP4_SUB;
+        const int64_t k_block = gsub / 16;  // QK_K / QK_NVFP4_SUB sub-blocks per block
+        const int sub = (int) (gsub % 16);
