+// One-time correctness gate (NEMO_SPEECH_NVFP4_SELFCHECK=1): quantize the same
+// random activation with the scalar single-pass and warp kernels and compare
+// the block_fp4_mmq output byte-for-byte.
+static void quantize_nvfp4_selftest(cudaStream_t stream) {
+    const int64_t ne00 = 1024, ne0 = 1024, ne1 = 64;
+    const int64_t nx = ne00 * ne1;
+    const int64_t nblk = (ne0 / QK_K) * ne1;
+    const size_t bytes_y = (size_t) nblk * sizeof(block_fp4_mmq);
+
+    std::vector<float> hx(nx);
+    for (auto & v : hx) v = (rand() / (float) RAND_MAX) * 4.0f - 2.0f;
+
+    float * dx = nullptr;
+    void * dy_s = nullptr;
+    void * dy_w = nullptr;
+    cudaMalloc(&dx, nx * sizeof(float));
+    cudaMalloc(&dy_s, bytes_y);
+    cudaMalloc(&dy_w, bytes_y);
+    cudaMemcpyAsync(dx, hx.data(), nx * sizeof(float), cudaMemcpyHostToDevice, stream);
+    cudaMemsetAsync(dy_s, 0, bytes_y, stream);
+    cudaMemsetAsync(dy_w, 0, bytes_y, stream);
+
+    const int64_t s01 = ne00, s02 = ne00 * ne1, s03 = ne00 * ne1;
+    {
+        constexpr int bs = 128;
+        const int64_t bny = (ne0 + QK_NVFP4_SUB * bs - 1) / (QK_NVFP4_SUB * bs);
+        quantize_mmq_nvfp4<<<dim3(ne1, bny, 1), dim3(bs, 1, 1), 0, stream>>>(
+            dx, nullptr, dy_s, ne00, s01, s02, s03, ne0, ne1, 1, /*search_width=*/1);
+    }
+    {
+        constexpr int nwarps = 8;
+        const int64_t bny = (ne0 + 512 - 1) / 512;
+        quantize_mmq_nvfp4_warp<<<dim3(ne1, bny, 1), dim3(WARP_SIZE, nwarps, 1), 0, stream>>>(
+            dx, nullptr, dy_w, ne00, s01, s02, s03, ne0, ne1, 1);
+    }
+    std::vector<uint8_t> ys(bytes_y), yw(bytes_y);
+    cudaMemcpyAsync(ys.data(), dy_s, bytes_y, cudaMemcpyDeviceToHost, stream);
+    cudaMemcpyAsync(yw.data(), dy_w, bytes_y, cudaMemcpyDeviceToHost, stream);
+    cudaStreamSynchronize(stream);
+
+    size_t mism = 0;
+    long first = -1;
+    for (size_t i = 0; i < bytes_y; i++) {
+        if (ys[i] != yw[i]) {
+            if (first < 0) first = (long) i;
+            mism++;
+        }
+    }
+    fprintf(stderr, "[nvfp4-selftest] bytes=%zu mismatches=%zu first=%ld : %s\n", bytes_y, mism,
+        first, mism ? "FAIL" : "PASS");
+    cudaFree(dx);
+    cudaFree(dy_s);
+    cudaFree(dy_w);
 
 }
 
