+        const bool ok = sub_start < ne0 && k_block < blocks_per_col;
+
+        if (ok && lin < 8) {
+            y[ib].qs[sub * 8 + lin] = (int8_t) (n | (hi << 4));
+        }
+        if (ok && lin == 0) {
+            reinterpret_cast<uint8_t *>(y[ib].d4)[sub] = fp8_code;
+        }
+    }
+#else
+    NO_DEVICE_CODE;
+#endif // defined(BLACKWELL_MMA_AVAILABLE)
+}
