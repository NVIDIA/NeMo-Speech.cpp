+// Pack and activate once per element, instead of once per output-channel tile.
+__global__ void conv1d_activate_pack(conv1d_fused_params p, half * dst) {
+    const int ci = blockIdx.x * blockDim.x + threadIdx.x;
+    const int t = blockIdx.y;
+    const int grp = blockIdx.z;
+    if (ci >= p.cin_pad) return;
+    float v = 0.0f;
+    if (ci < p.cin) {
+        const int cb = (p.shared_input ? 0 : grp * p.cin) + ci;
+        v = t < p.cache_len ? p.cache[(size_t)cb * p.cs + t]
+                            : p.x[(size_t)cb * p.xs + t - p.cache_len];
+        if (p.alpha) {
+            if (ci < p.snake_ch) {
+                const float sn = __sinf(p.alpha[grp * p.snake_ch + ci] * v);
+                v = v + sn * sn * p.inv_b[grp * p.snake_ch + ci];
+            } else {
+                v = v > 0.f ? v : v * p.slope;
+            }
+        }
+    }
+    dst[((size_t)grp * (p.cache_len + p.T) + t) * p.cin_pad + ci] = __float2half(v);
+}
