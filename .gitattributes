# Keep ggml patch files LF on every platform. On Windows with core.autocrlf=true
# they would otherwise check out CRLF, and `git apply` rejects some hunks as
# "corrupt patch" on mixed endings (notably 0007-magpietts-nanocodec.patch).
ggml-patches/*.patch text eol=lf -whitespace
llama-patches/*.patch text eol=lf -whitespace
# Shell scripts must stay LF so they run under bash / Git Bash on Windows.
*.sh text eol=lf
src/tts/tokenizer/mandarin_data/pinyin_phrases.tsv filter=lfs diff=lfs merge=lfs -text
src/tts/tokenizer/mandarin_data/pinyin_chars.tsv filter=lfs diff=lfs merge=lfs -text
src/tts/tokenizer/mandarin_data/jieba.dict.utf8 filter=lfs diff=lfs merge=lfs -text
src/tts/tokenizer/mandarin_data/hmm_model.utf8 filter=lfs diff=lfs merge=lfs -text
