{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 26,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "NEMO_SPEECH_BUILD_EXAMPLES": "OFF",
        "NEMO_SPEECH_BUILD_TESTS": "OFF",
        "NEMO_SPEECH_BUILD_TOOLS": "OFF"
      }
    },
    {
      "name": "cpu-asr",
      "inherits": "base",
      "displayName": "CPU ASR and diarization",
      "cacheVariables": {
        "NEMO_SPEECH_GGML_PATCHED": "OFF",
        "NEMO_SPEECH_BUILD_ASR": "ON",
        "NEMO_SPEECH_BUILD_DIAR": "ON",
        "NEMO_SPEECH_BUILD_TTS": "OFF",
        "NEMO_SPEECH_BUILD_NMT": "OFF"
      }
    },
    {
      "name": "cpu-diar",
      "inherits": "base",
      "displayName": "CPU standalone diarization",
      "cacheVariables": {
        "NEMO_SPEECH_GGML_PATCHED": "OFF",
        "NEMO_SPEECH_BUILD_ASR": "OFF",
        "NEMO_SPEECH_BUILD_DIAR": "ON",
        "NEMO_SPEECH_BUILD_TTS": "OFF",
        "NEMO_SPEECH_BUILD_NMT": "OFF"
      }
    },
    {
      "name": "cpu-tts",
      "inherits": "base",
      "displayName": "CPU text-to-speech",
