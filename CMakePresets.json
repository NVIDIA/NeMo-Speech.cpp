        "NEMO_SPEECH_BUILD_DIAR": "OFF",
        "NEMO_SPEECH_BUILD_TTS": "ON",
        "NEMO_SPEECH_BUILD_NMT": "OFF"
      }
    },
    {
      "name": "cpu-nmt",
      "inherits": "base",
      "displayName": "CPU text translation",
      "cacheVariables": {
        "NEMO_SPEECH_GGML_PATCHED": "OFF",
        "NEMO_SPEECH_BUILD_ASR": "OFF",
        "NEMO_SPEECH_BUILD_DIAR": "OFF",
        "NEMO_SPEECH_BUILD_TTS": "OFF",
        "NEMO_SPEECH_BUILD_NMT": "ON"
      }
    },
    {
      "name": "cpu-speech",
      "inherits": "base",
      "displayName": "CPU ASR, diarization, NMT, and TTS",
      "cacheVariables": {
        "NEMO_SPEECH_GGML_PATCHED": "OFF",
